---
import Base from '../layouts/Base.astro';
import allStudiesData from '../data/market_studies_all.json';

const seo = {
  title: 'Explorador de Mercado & Búsquedas SEO | Advantia CatalogAI',
  description: 'Desagrega todas las formas en las que los compradores buscan productos en Colombia: variaciones de nombres, marcas, colores, materiales, capacidades y dudas de salud.',
  canonical: 'https://theadvantia.com/estudios-de-mercado',
  // Herramienta interna del portal: protegida en el servidor y fuera de buscadores
  robots: 'noindex, nofollow',
};
---

<Base seo={seo} active="/estudios-de-mercado">
  <main class="em-main">

    <!-- Top Navigation Bar -->
    <header class="em-nav">
      <div class="wrap em-nav-in">
        <div class="em-brand">
          <a href="/aplicativos" class="back-link">← Volver a Aplicativos</a>
          <span class="divider">|</span>
          <span class="nav-title">📊 CatalogAI Market Intelligence Studio</span>
        </div>
        <div class="em-nav-actions">
          <span class="live-pill">🟢 Dataset Colombia 2026</span>
          <a href="/aplicativos" class="app-btn btn-secondary sm">Portal de Aplicativos</a>
        </div>
      </div>
    </header>

    <!-- Hero Header -->
    <section class="em-hero">
      <div class="wrap">
        <div class="hero-badge">
          <span class="sparkle">✨</span> EXPLORADOR MULTIDIMENSIONAL DE BÚSQUEDAS
        </div>
        <h1 class="hero-title">¿Cómo buscan los compradores tu producto en Colombia?</h1>
        <p class="hero-subtitle">
          Desagrega la demanda real por <strong>variaciones de nombre</strong>, <strong>marcas</strong>, <strong>materiales</strong>, <strong>colores</strong>, <strong>capacidades</strong> y <strong>preguntas de salud</strong> para optimizar tu catálogo con el protocolo <strong>CatalogAI</strong>.
        </p>

        <!-- Dynamic Category Selector -->
        <div class="cat-picker-container">
          <label class="picker-label">Selecciona la Categoría de Estudio:</label>
          <div class="picker-buttons" id="catPicker">
            <button class="picker-btn active" data-cat="ollas">
              <span class="icon">🍲</span>
              <div class="txt">
                <strong>Ollas & Cocina</strong>
                <small>+422.840 búsquedas/mes</small>
              </div>
            </button>
            <button class="picker-btn" data-cat="relojes">
              <span class="icon">⌚</span>
              <div class="txt">
                <strong>Relojes & Accesorios</strong>
                <small>+370.880 búsquedas/mes</small>
              </div>
            </button>
            <button class="picker-btn" data-cat="lenceria">
              <span class="icon">👙</span>
              <div class="txt">
                <strong>Lencería & Ropa Interior</strong>
                <small>+569.840 búsquedas/mes</small>
              </div>
            </button>
            <button class="picker-btn" data-cat="abrigos">
              <span class="icon">🧥</span>
              <div class="txt">
                <strong>Abrigos & Chaquetas</strong>
                <small>+459.470 búsquedas/mes</small>
              </div>
            </button>
            <button class="picker-btn" data-cat="camisetas">
              <span class="icon">👕</span>
              <div class="txt">
                <strong>Camisetas & Deportiva</strong>
                <small>+794.040 búsquedas/mes</small>
              </div>
            </button>
          </div>
        </div>
      </div>
    </section>

    <!-- Interactive Multi-Dimensional Control Panel -->
    <section class="em-controls-section">
      <div class="wrap">
        <div class="controls-card">
          <div class="search-main-row">
            <div class="search-box">
              <span class="search-icon">🔍</span>
              <input 
                type="text" 
                id="emSearch" 
                placeholder="Busca cualquier término (ej: imusa, acero inoxidable, 6 litros, negro, teflon, express...)" 
                class="em-search-input" 
              />
              <button class="clear-btn" id="btnClearSearch">×</button>
            </div>
            <div class="quick-stats-summary">
              <div class="stat-item">
                <span>Volumen Filtrado:</span>
                <strong id="statVolume">254.800/mes</strong>
              </div>
              <div class="stat-item">
                <span>Keywords Visibles:</span>
                <strong id="statCount">664</strong>
              </div>
            </div>
          </div>

          <!-- Dimension Pills -->
          <div class="dimension-filters">
            <span class="dim-label">Filtrar por Dimensión de Búsqueda:</span>
            <div class="pills-group" id="dimensionPills">
              <button class="dim-pill active" data-dim="all">Todas las Formas</button>
              <button class="dim-pill" data-dim="nomenclatura">💬 Nombres & Sinónimos</button>
              <button class="dim-pill" data-dim="marcas">🏷️ Marcas & Competencia</button>
              <button class="dim-pill" data-dim="materiales">🧱 Materiales & Tecnología</button>
              <button class="dim-pill" data-dim="capacidades">📏 Capacidades & Medidas</button>
              <button class="dim-pill" data-dim="colores">🎨 Colores & Estética</button>
              <button class="dim-pill" data-dim="salud">🩺 Preguntas / Salud & PFOA</button>
              <button class="dim-pill highlight" data-dim="quickwins">🚀 Quick Wins (+100% YoY)</button>
            </div>
          </div>

          <!-- Sub-Filter Bar (Brands, Materials, Colors, Sizes) -->
          <div class="sub-filters-grid">
            <div class="sub-filter-item">
              <label for="subBrand">Filtrar por Marca</label>
              <select id="subBrand" class="em-select">
                <option value="all">Todas las Marcas</option>
                <option value="imusa">Imusa</option>
                <option value="universal">Universal</option>
                <option value="royal prestige">Royal Prestige</option>
                <option value="tramontina">Tramontina</option>
                <option value="oster">Oster</option>
                <option value="black and decker">Black & Decker</option>
                <option value="tefal">Tefal / T-Fal</option>
                <option value="le creuset">Le Creuset</option>
                <option value="bergner">Bergner</option>
                <option value="ninja">Ninja</option>
                <option value="victoria">Victoria</option>
              </select>
            </div>

            <div class="sub-filter-item">
              <label for="subMaterial">Filtrar por Material</label>
              <select id="subMaterial" class="em-select">
                <option value="all">Todos los Materiales</option>
                <option value="acero inoxidable">Acero Inoxidable</option>
                <option value="acero quirurgico">Acero Quirúrgico</option>
                <option value="hierro fundido">Hierro Fundido</option>
                <option value="antiadherente">Antiadherente / Teflón</option>
                <option value="ceramica">Cerámica</option>
                <option value="barro">Barro / Peltre</option>
                <option value="vidrio">Vidrio / Cristal</option>
                <option value="titanio">Titanio</option>
                <option value="aluminio">Aluminio / Fundido</option>
              </select>
            </div>

            <div class="sub-filter-item">
              <label for="subColor">Filtrar por Color / Estética</label>
              <select id="subColor" class="em-select">
                <option value="all">Todos los Colores</option>
                <option value="negro">Negro / Negras</option>
                <option value="rosa">Rosado / Rosas</option>
                <option value="blanco">Blanco / Blancas</option>
                <option value="rojo">Rojo / Rojas</option>
                <option value="cobre">Cobre</option>
              </select>
            </div>

            <div class="sub-filter-item">
              <label for="subCapacity">Filtrar por Capacidad / Tamaño</label>
              <select id="subCapacity" class="em-select">
                <option value="all">Todas las Capacidades</option>
                <option value="1 a 3">Pequeña (1 a 3 Litros / 1 Libra)</option>
                <option value="4 a 7">Mediana (4 a 7 Litros)</option>
                <option value="10 a 50">Grande / Industrial (10 a 50 Litros)</option>
                <option value="20 a 30 cm">Diámetro (20 a 30 cm)</option>
              </select>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Interactive Charts & Behavior Section -->
    <section class="em-analytics-section">
      <div class="wrap">
        <div class="sec-header-flex">
          <div>
            <h2 class="sec-title">📈 Gráficas de Comportamiento e Inteligencia de Mercado</h2>
            <p class="sec-subtitle">Visualización interactiva en tiempo real del volumen de búsqueda, cuota de marcas, preferencia de materiales y tendencias YoY.</p>
          </div>
          <div class="chart-controls">
            <span class="chart-badge">📊 Motor Chart.js Activo</span>
          </div>
        </div>
        
        <!-- Major Charts Row: Time Series (4 Years) & 4-Axis Matrix -->
        <div class="charts-major-row margin-bottom">
          
          <!-- Chart A: Timeline Search Trends 2022-2026 -->
          <article class="chart-card full-width">
            <div class="chart-header">
              <span class="chart-icon">📅</span>
              <div>
                <h3>Evolución Histórica de Búsquedas en el Tiempo (Septiembre 2022 – Agosto 2026)</h3>
                <small>Tendencia de búsquedas mensuales a lo largo de 4 años para verificar aceleración o declive por categoría</small>
              </div>
            </div>
            <div class="chart-container large">
              <canvas id="chartTimeSeries"></canvas>
            </div>
          </article>

          <!-- Chart B: 4-Axis Strategic Matrix -->
          <article class="chart-card full-width">
            <div class="chart-header">
              <span class="chart-icon">🎯</span>
              <div>
                <h3>Matriz Estratégica de 4 Ejes (Volumen vs Crecimiento YoY vs Dificultad vs Intención)</h3>
                <small>Eje X: Volumen | Eje Y: Crecimiento YoY % | Tamaño Burbuja: Competencia | Color: Intención Comercial</small>
              </div>
            </div>
            <div class="chart-container large">
              <canvas id="chart4Axis"></canvas>
            </div>
          </article>

        </div>

        <div class="charts-grid">

          
          <!-- Chart 1: Marcas Líderes -->
          <article class="chart-card">
            <div class="chart-header">
              <span class="chart-icon">🏷️</span>
              <div>
                <h3>Cuota de Búsqueda por Marcas (Búsquedas/Mes)</h3>
                <small>Volumen mensual de búsqueda en Colombia</small>
              </div>
            </div>
            <div class="chart-container">
              <canvas id="chartBrands"></canvas>
            </div>
          </article>

          <!-- Chart 2: Preferencia por Materiales -->
          <article class="chart-card">
            <div class="chart-header">
              <span class="chart-icon">🧱</span>
              <div>
                <h3>Participación de Mercado por Materiales</h3>
                <small>Distribución porcentual de preferencia técnica</small>
              </div>
            </div>
            <div class="chart-container">
              <canvas id="chartMaterials"></canvas>
            </div>
          </article>

          <!-- Chart 3: Tendencias YoY & Quick Wins -->
          <article class="chart-card">
            <div class="chart-header">
              <span class="chart-icon">🚀</span>
              <div>
                <h3>Top Quick Wins — Crecimiento YoY (%)</h3>
                <small>Categorías con mayor aceleración de demanda</small>
              </div>
            </div>
            <div class="chart-container">
              <canvas id="chartYoY"></canvas>
            </div>
          </article>

          <!-- Chart 4: Intención de Búsqueda del Comprador -->
          <article class="chart-card">
            <div class="chart-header">
              <span class="chart-icon">🎯</span>
              <div>
                <h3>Desglose por Intención de Búsqueda</h3>
                <small>Clasificación de embudo: Transaccional vs Marca vs Salud</small>
              </div>
            </div>
            <div class="chart-container">
              <canvas id="chartIntent"></canvas>
            </div>
          </article>

        </div>
      </div>
    </section>


    <!-- Main Results Table -->
    <section class="em-table-section">
      <div class="wrap">
        <div class="table-card">
          <div class="table-header-bar">
            <div class="th-info">
              <h3>Matriz Detallada de Palabras Clave</h3>
              <p>Mostrando los resultados filtrados listos para optimizar títulos y descripciones.</p>
            </div>
            <div class="th-actions">
              <button class="app-btn btn-secondary sm" id="btnExportCSVMain">📥 Exportar CSV</button>
              <button class="app-btn btn-primary sm" id="btnCopyCatalogMain">📋 Copiar para CatalogAI</button>
            </div>
          </div>

          <div class="table-responsive">
            <table class="em-data-table">
              <thead>
                <tr>
                  <th>Palabra Clave</th>
                  <th>Búsquedas/Mes</th>
                  <th>Tendencia YoY</th>
                  <th>Competencia</th>
                  <th>Dimensión / Intención</th>
                  <th>Mapeo CatalogAI (Sección / Bloque)</th>
                </tr>
              </thead>
              <tbody id="emTableBody">
                <!-- Dynamically populated by JS -->
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

  </main>
</Base>

<style>
  .em-main {
    background: #09172A;
    color: #ffffff;
    min-height: 100vh;
    padding-bottom: 80px;
    font-family: var(--font-body);
  }

  .em-nav {
    background: rgba(11, 31, 58, 0.9);
    border-bottom: 1px solid rgba(176, 141, 87, 0.25);
    padding: 14px 0;
    position: sticky;
    top: 0;
    z-index: 100;
    backdrop-filter: blur(10px);
  }
  .em-nav-in {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .back-link {
    color: #B08D57;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
  }
  .back-link:hover { text-decoration: underline; }
  .divider { color: rgba(255, 255, 255, 0.2); margin: 0 10px; }
  .nav-title { font-size: 14px; font-weight: 800; color: #ffffff; }
  .em-nav-actions { display: flex; align-items: center; gap: 12px; }
  .live-pill { background: rgba(27, 175, 122, 0.15); color: #1BAF7A; border: 1px solid rgba(27, 175, 122, 0.3); padding: 4px 10px; border-radius: 999px; font-size: 11px; font-weight: 700; }

  /* Hero */
  .em-hero {
    padding: 50px 0 30px 0;
    text-align: center;
    background: radial-gradient(circle at top center, rgba(30, 39, 97, 0.6) 0%, transparent 70%);
  }
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(176, 141, 87, 0.15);
    color: #B08D57;
    border: 1px solid rgba(176, 141, 87, 0.3);
    padding: 6px 14px;
    border-radius: 9999px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.5px;
    margin-bottom: 16px;
  }
  .hero-title {
    font-family: var(--font-display);
    font-size: 34px;
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 12px;
  }
  .hero-subtitle {
    font-size: 16px;
    color: #b3b3b3;
    max-width: 760px;
    margin: 0 auto 30px auto;
    line-height: 1.6;
  }

  /* Picker */
  .cat-picker-container { margin-top: 20px; }
  .picker-label { font-size: 12px; font-weight: 700; color: #a3a3a3; text-transform: uppercase; letter-spacing: 0.5px; display: block; margin-bottom: 12px; }
  .picker-buttons { display: flex; justify-content: center; gap: 12px; flex-wrap: wrap; }
  .picker-btn {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    padding: 12px 18px;
    display: flex;
    align-items: center;
    gap: 12px;
    cursor: pointer;
    transition: all 0.2s ease;
    text-align: left;
  }
  .picker-btn:hover { background: rgba(176, 141, 87, 0.15); border-color: rgba(176, 141, 87, 0.4); transform: translateY(-2px); }
  .picker-btn.active { background: rgba(176, 141, 87, 0.25); border-color: #B08D57; box-shadow: 0 0 20px rgba(176, 141, 87, 0.3); }
  .picker-btn .icon { font-size: 24px; }
  .picker-btn .txt strong { display: block; color: #ffffff; font-size: 13px; }
  .picker-btn .txt small { color: #1BAF7A; font-size: 11px; font-weight: 700; }

  /* Controls Section */
  .em-controls-section { padding: 20px 0; }
  .controls-card {
    background: rgba(18, 40, 76, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    padding: 24px;
    backdrop-filter: blur(10px);
  }
  .search-main-row { display: flex; gap: 16px; align-items: center; margin-bottom: 20px; }
  .search-box { flex-grow: 1; position: relative; display: flex; align-items: center; }
  .search-icon { position: absolute; left: 14px; font-size: 16px; color: #a3a3a3; }
  .em-search-input {
    width: 100%;
    background: rgba(11, 31, 58, 0.9);
    border: 1px solid rgba(176, 141, 87, 0.4);
    border-radius: 10px;
    padding: 14px 40px 14px 42px;
    color: #ffffff;
    font-size: 15px;
    font-weight: 600;
    outline: none;
    transition: all 0.2s ease;
  }
  .em-search-input:focus { border-color: #B08D57; box-shadow: 0 0 15px rgba(176, 141, 87, 0.4); }
  .clear-btn { position: absolute; right: 14px; background: none; border: none; color: #a3a3a3; font-size: 20px; cursor: pointer; }

  .quick-stats-summary { display: flex; gap: 16px; background: rgba(0, 0, 0, 0.3); padding: 10px 16px; border-radius: 10px; border: 1px solid rgba(255, 255, 255, 0.08); }
  .stat-item { display: flex; flex-direction: column; font-size: 11px; color: #a3a3a3; }
  .stat-item strong { font-size: 14px; color: #ffffff; }

  /* Dimension Pills */
  .dimension-filters { margin-bottom: 20px; text-align: left; }
  .dim-label { font-size: 11px; font-weight: 700; color: #B08D57; text-transform: uppercase; letter-spacing: 0.5px; display: block; margin-bottom: 10px; }
  .pills-group { display: flex; gap: 8px; flex-wrap: wrap; }
  .dim-pill {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #e2e8f0;
    padding: 7px 14px;
    border-radius: 9999px;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .dim-pill:hover { background: rgba(176, 141, 87, 0.2); border-color: #B08D57; }
  .dim-pill.active { background: #B08D57; color: #0B1F3A; font-weight: 800; border-color: #B08D57; box-shadow: 0 4px 12px rgba(176, 141, 87, 0.4); }
  .dim-pill.highlight { border-color: #f59e0b; color: #fbbf24; }

  /* Sub-filters Grid */
  .sub-filters-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
  .sub-filter-item { display: flex; flex-direction: column; text-align: left; }
  .sub-filter-item label { font-size: 11px; font-weight: 700; color: #a3a3a3; margin-bottom: 6px; }
  .em-select {
    background: rgba(11, 31, 58, 0.9);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 8px;
    padding: 8px 12px;
    color: #ffffff;
    font-size: 12px;
    outline: none;
  }

  /* Charts & Analytics Section */
  .em-analytics-section { padding: 30px 0; }
  .sec-header-flex { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 20px; }
  .sec-title { font-family: var(--font-display); font-size: 22px; font-weight: 800; color: #ffffff; margin: 0; text-align: left; }
  .sec-subtitle { font-size: 13px; color: #a3a3a3; margin: 4px 0 0 0; text-align: left; }
  .chart-badge { background: rgba(176, 141, 87, 0.15); color: #B08D57; border: 1px solid rgba(176, 141, 87, 0.3); padding: 4px 10px; border-radius: 6px; font-size: 11px; font-weight: 700; }
  
  .charts-major-row { display: flex; flex-direction: column; gap: 20px; }
  .chart-card.full-width { width: 100%; box-sizing: border-box; }
  .chart-container.large { height: 340px; }

  .margin-bottom { margin-bottom: 20px; }
  .charts-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
  .chart-card { background: rgba(18, 40, 76, 0.6); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 16px; padding: 20px; text-align: left; display: flex; flex-direction: column; backdrop-filter: blur(10px); }
  .chart-header { display: flex; align-items: center; gap: 12px; margin-bottom: 16px; }
  .chart-icon { font-size: 24px; background: rgba(255, 255, 255, 0.05); padding: 8px; border-radius: 10px; }
  .chart-header h3 { font-size: 15px; font-weight: 800; color: #ffffff; margin: 0; }
  .chart-header small { color: #a3a3a3; font-size: 11px; }
  .chart-container { position: relative; width: 100%; height: 260px; }



  /* Table Section */
  .em-table-section { padding: 20px 0; }
  .table-card { background: rgba(18, 40, 76, 0.6); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 16px; overflow: hidden; }
  .table-header-bar { padding: 20px; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid rgba(255, 255, 255, 0.08); }
  .th-info h3 { font-size: 18px; font-weight: 800; color: #ffffff; margin: 0 0 4px 0; }
  .th-info p { font-size: 12px; color: #a3a3a3; margin: 0; }
  .th-actions { display: flex; gap: 10px; }

  .table-responsive { max-height: 500px; overflow-y: auto; }
  .em-data-table { width: 100%; border-collapse: collapse; font-size: 12px; text-align: left; }
  .em-data-table th { position: sticky; top: 0; background: #12284C; color: #B08D57; font-weight: 800; padding: 12px 16px; border-bottom: 2px solid rgba(176, 141, 87, 0.3); z-index: 2; }
  .em-data-table td { padding: 12px 16px; border-bottom: 1px solid rgba(255, 255, 255, 0.05); color: #e2e8f0; }
  .em-data-table tbody tr:hover { background: rgba(176, 141, 87, 0.12); }

  @media (max-width: 992px) {
    .sub-filters-grid { grid-template-columns: 1fr 1fr; }
    .analytics-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 576px) {
    .sub-filters-grid { grid-template-columns: 1fr; }
    .search-main-row { flex-direction: column; align-items: stretch; }
  }
</style>

<script is:inline src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script define:vars={{ allStudiesData }}>
  document.addEventListener('DOMContentLoaded', () => {
    const STUDIES_BUNDLE = allStudiesData || {};
    let currentCat = 'ollas';
    let RAW_DATASET = STUDIES_BUNDLE['ollas'] || [];
    let chartInstances = {};

    const CATEGORY_META = {
      ollas: {
        name: 'Ollas, Sartenes & Menaje de Cocina',
        brands: ['Imusa', 'Universal', 'Royal Prestige', 'Oster', 'Tramontina', 'Tefal', 'Ninja'],
        brandCounts: [23800, 18600, 15400, 9200, 6200, 4800, 3900],
        materials: ['Antiadherente', 'Acero Inoxidable', 'Hierro Fundido', 'Cerámica', 'Titanio', 'Barro/Peltre'],
        materialCounts: [40, 28, 16, 10, 4, 2],
        trendLabels: ['Ollas a Presión', 'Antiadherente', 'Hierro/Titanio (Emergentes)', 'Barro/Peltre'],
        quickWins: ['Sartenes Titanio', 'Sartenes Ninja', 'Acero al Carbono', 'Sarten Tramontina', 'Olla Presión Oster', 'Olla Imusa Multi'],
        quickWinYoY: [555, 467, 271, 233, 200, 177]
      },
      relojes: {
        name: 'Relojes & Accesorios Hombre/Mujer',
        brands: ['Casio', 'Rolex', 'Fossil', 'Invicta', 'Tissot', 'Diesel', 'Adidas'],
        brandCounts: [33000, 27100, 18100, 14800, 12100, 9900, 8100],
        materials: ['Acero Inoxidable', 'Oro/Plata', 'Cuero', 'Titanio', 'Silicona', 'Resina'],
        materialCounts: [38, 25, 18, 10, 6, 3],
        trendLabels: ['Smartwatches', 'Relojes Hombre Clásicos', 'Relojes Sumergibles', 'Relojes Mujer Lujo'],
        quickWins: ['Smartwatch Militar', 'Reloj Deportivo Impermeable', 'Casio Vintage Dorado', 'Reloj Automático Titanio'],
        quickWinYoY: [320, 240, 180, 150]
      },
      lenceria: {
        name: 'Lencería, Brasieres & Ropa Interior',
        brands: ['Leonisa', 'Bésame', 'Lili Pink', 'Chamela', 'Diane & Geordi', 'Gef'],
        brandCounts: [49500, 33100, 27100, 18100, 14800, 12100],
        materials: ['Encaje / Blonda', 'Algodón', 'Seda / Satín', 'Seamless / Sin Costuras', 'Microfibra / Lycra'],
        materialCounts: [35, 30, 15, 12, 8],
        trendLabels: ['Brasieres Strapless/Push Up', 'Fajas Moldeadoras', 'Bralettes Encaje', 'Pantis Sin Costuras'],
        quickWins: ['Bralette de Encaje', 'Faja Reductora Invisible', 'Brasier Strapless Push Up', 'Cachetero Seamless'],
        quickWinYoY: [410, 310, 220, 160]
      },
      abrigos: {
        name: 'Abrigos, Chaquetas & Ropa de Invierno',
        brands: ['The North Face', 'Columbia', 'Zara', 'Arturo Calle', 'Patagonia', 'Chevignon'],
        brandCounts: [27100, 22200, 18100, 14800, 12100, 9900],
        materials: ['Cuero Genuino', 'Plumas / Duvet', 'Lana / Paño', 'Impermeable / Térmico', 'Denim / Jean'],
        materialCounts: [32, 28, 20, 14, 6],
        trendLabels: ['Chaquetas Rompevientos', 'Abrigos Largos Paño', 'Parkas Térmicas', 'Chaquetas de Cuero'],
        quickWins: ['Chaqueta Térmica Impermeable', 'Parka con Capota', 'Abrigo Trench Clásico', 'Bomber Jacket Cuero'],
        quickWinYoY: [280, 210, 175, 140]
      },
      camisetas: {
        name: 'Camisetas, Polos & Moda Deportiva',
        brands: ['Adidas', 'Nike', 'Puma', 'Under Armour', 'Lacoste', 'Tommy Hilfiger'],
        brandCounts: [60500, 49500, 27100, 22200, 18100, 14800],
        materials: ['Algodón 100%', 'Dri-Fit / Poliéster', 'Piqué (Polos)', 'Oversize / Heavyweight'],
        materialCounts: [45, 30, 15, 10],
        trendLabels: ['Camisetas Selección Colombia', 'Camisetas Oversize', 'Polos Cuello Piqué', 'Camisetas Deportivas Gym'],
        quickWins: ['Camiseta Selección Colombia 2026', 'Camiseta Oversize Estampada', 'Camiseta Gym Dry Fit', 'Polo Clásica Algodón'],
        quickWinYoY: [620, 450, 310, 220]
      }
    };

    // Initialize & Refresh Chart.js Instances
    const updateCharts = (catId) => {
      if (typeof Chart === 'undefined') return;

      Chart.defaults.color = '#94a3b8';
      Chart.defaults.font.family = 'Inter, sans-serif';

      const meta = CATEGORY_META[catId] || CATEGORY_META.ollas;

      // 1. Chart Time Series 4 Years
      const ctxTimeSeries = document.getElementById('chartTimeSeries');
      if (ctxTimeSeries) {
        if (chartInstances.timeSeries) chartInstances.timeSeries.destroy();
        chartInstances.timeSeries = new Chart(ctxTimeSeries, {
          type: 'line',
          data: {
            labels: ['Sep 22', 'Ene 23', 'May 23', 'Sep 23', 'Ene 24', 'May 24', 'Sep 24', 'Ene 25', 'May 25', 'Sep 25', 'Ene 26', 'Ago 26'],
            datasets: [
              {
                label: meta.trendLabels[0] || 'Línea Principal',
                data: [18500, 19200, 20100, 21400, 22000, 21800, 23500, 24100, 23800, 24000, 24200, 24400],
                borderColor: '#1BAF7A',
                backgroundColor: 'rgba(27, 175, 122, 0.15)',
                fill: true,
                tension: 0.3,
                borderWidth: 3
              },
              {
                label: meta.trendLabels[1] || 'Línea Secundaria',
                data: [12100, 12500, 13400, 14200, 15100, 16000, 16800, 17500, 18200, 19000, 19800, 20500],
                borderColor: '#3b82f6',
                backgroundColor: 'rgba(59, 130, 246, 0.1)',
                fill: true,
                tension: 0.3,
                borderWidth: 2
              },
              {
                label: meta.trendLabels[2] || 'Línea Emergente 🚀',
                data: [850, 1100, 1400, 1900, 2600, 3400, 4500, 5800, 7200, 8900, 10500, 12800],
                borderColor: '#f59e0b',
                backgroundColor: 'rgba(245, 158, 11, 0.1)',
                fill: true,
                tension: 0.3,
                borderWidth: 3
              }
            ]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: { position: 'top', labels: { boxWidth: 14, font: { size: 12 } } },
              tooltip: {
                callbacks: {
                  label: (ctx) => ` ${ctx.dataset.label}: ${ctx.raw.toLocaleString('es-CO')} búsquedas/mes`
                }
              }
            },
            scales: {
              y: { grid: { color: 'rgba(255, 255, 255, 0.05)' }, title: { display: true, text: 'Búsquedas Mensuales (Google CO)', color: '#94a3b8' } },
              x: { grid: { color: 'rgba(255, 255, 255, 0.05)' } }
            }
          }
        });
      }

      // 2. Chart 4-Axis Matrix
      const ctx4Axis = document.getElementById('chart4Axis');
      if (ctx4Axis) {
        if (chartInstances.axis4) chartInstances.axis4.destroy();
        const top5 = RAW_DATASET.slice(0, 8);
        chartInstances.axis4 = new Chart(ctx4Axis, {
          type: 'bubble',
          data: {
            datasets: [
              {
                label: 'Keywords de Alta Demanda',
                data: top5.map(x => ({ x: x.vol, y: parseInt(x.yoy) || 10, r: Math.max(6, Math.min(22, Math.round(x.vol / 2000))), kw: x.kw })),
                backgroundColor: 'rgba(27, 175, 122, 0.75)',
                borderColor: '#1BAF7A'
              },
              {
                label: 'Quick Wins (+100% YoY) 🚀',
                data: RAW_DATASET.filter(x => x.intent === 'quickwin' || x.yoy.startsWith('+5') || x.yoy.startsWith('+2')).slice(0, 5).map(x => ({
                  x: x.vol, y: parseInt(x.yoy) || 150, r: 12, kw: x.kw
                })),
                backgroundColor: 'rgba(245, 158, 11, 0.85)',
                borderColor: '#f59e0b'
              }
            ]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: { position: 'top', labels: { boxWidth: 12, font: { size: 11 } } },
              tooltip: {
                callbacks: {
                  label: (ctx) => {
                    const item = ctx.raw;
                    return ` [${item.kw}] Vol: ${item.x.toLocaleString('es-CO')}/mes | Crecimiento: ${item.y}%`;
                  }
                }
              }
            },
            scales: {
              x: { type: 'logarithmic', grid: { color: 'rgba(255, 255, 255, 0.05)' }, title: { display: true, text: 'Volumen Mensual (Escala Log)', color: '#94a3b8' } },
              y: { grid: { color: 'rgba(255, 255, 255, 0.05)' }, title: { display: true, text: 'Crecimiento YoY (%)', color: '#94a3b8' } }
            }
          }
        });
      }

      // 3. Chart Brands
      const ctxBrands = document.getElementById('chartBrands');
      if (ctxBrands) {
        if (chartInstances.brands) chartInstances.brands.destroy();
        chartInstances.brands = new Chart(ctxBrands, {
          type: 'bar',
          data: {
            labels: meta.brands,
            datasets: [{
              label: 'Búsquedas Mensuales',
              data: meta.brandCounts,
              backgroundColor: 'rgba(176, 141, 87, 0.85)',
              borderColor: '#B08D57',
              borderWidth: 1,
              borderRadius: 6
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
              y: { grid: { color: 'rgba(255, 255, 255, 0.05)' } },
              x: { grid: { display: false } }
            }
          }
        });
      }

      // 4. Chart Materials
      const ctxMaterials = document.getElementById('chartMaterials');
      if (ctxMaterials) {
        if (chartInstances.materials) chartInstances.materials.destroy();
        chartInstances.materials = new Chart(ctxMaterials, {
          type: 'doughnut',
          data: {
            labels: meta.materials,
            datasets: [{
              data: meta.materialCounts,
              backgroundColor: ['#1BAF7A', '#3b82f6', '#f59e0b', '#ec4899', '#8b5cf6', '#64748b'],
              borderWidth: 2,
              borderColor: '#09172A'
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { position: 'right', labels: { boxWidth: 12, font: { size: 11 } } } }
          }
        });
      }

      // 5. Chart YoY Quick Wins
      const ctxYoY = document.getElementById('chartYoY');
      if (ctxYoY) {
        if (chartInstances.yoy) chartInstances.yoy.destroy();
        chartInstances.yoy = new Chart(ctxYoY, {
          type: 'bar',
          data: {
            labels: meta.quickWins,
            datasets: [{
              label: 'Crecimiento YoY (%)',
              data: meta.quickWinYoY,
              backgroundColor: 'rgba(245, 158, 11, 0.85)',
              borderColor: '#f59e0b',
              borderWidth: 1,
              borderRadius: 6
            }]
          },
          options: {
            indexAxis: 'y',
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
              x: { grid: { color: 'rgba(255, 255, 255, 0.05)' } },
              y: { grid: { display: false } }
            }
          }
        });
      }
    };

    // Category Selector
    const catPickerBtns = document.querySelectorAll('#catPicker .picker-btn');
    catPickerBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        catPickerBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        currentCat = btn.getAttribute('data-cat') || 'ollas';
        RAW_DATASET = STUDIES_BUNDLE[currentCat] || [];
        updateCharts(currentCat);
        renderTable();
      });
    });

    const emSearch = document.getElementById('emSearch');
    const btnClearSearch = document.getElementById('btnClearSearch');
    const dimPills = document.querySelectorAll('#dimensionPills .dim-pill');
    const subBrand = document.getElementById('subBrand');
    const subMaterial = document.getElementById('subMaterial');
    const subColor = document.getElementById('subColor');
    const subCapacity = document.getElementById('subCapacity');
    const emTableBody = document.getElementById('emTableBody');
    const statVolume = document.getElementById('statVolume');
    const statCount = document.getElementById('statCount');

    let activeDim = 'all';

    const renderTable = () => {
      if (!emTableBody) return;

      const searchVal = emSearch ? emSearch.value.toLowerCase().trim() : '';
      const brandVal = subBrand ? subBrand.value : 'all';
      const matVal = subMaterial ? subMaterial.value : 'all';
      const colorVal = subColor ? subColor.value : 'all';
      const capVal = subCapacity ? subCapacity.value : 'all';

      const filtered = RAW_DATASET.filter(item => {
        const matchDim = activeDim === 'all' || item.dim === activeDim || (activeDim === 'quickwins' && item.intent === 'quickwin');
        const matchSearch = !searchVal || item.kw.toLowerCase().includes(searchVal);
        const matchBrand = brandVal === 'all' || item.brand === brandVal;
        const matchMat = matVal === 'all' || item.mat === matVal;
        const matchColor = colorVal === 'all' || item.col === colorVal;
        const matchCap = capVal === 'all' || item.cap === capVal;

        return matchDim && matchSearch && matchBrand && matchMat && matchColor && matchCap;
      });

      const totalVol = filtered.reduce((acc, curr) => acc + curr.vol, 0);
      if (statVolume) statVolume.innerText = `${totalVol.toLocaleString('es-CO')}/mes`;
      if (statCount) statCount.innerText = `${filtered.length} Keywords`;

      if (filtered.length === 0) {
        emTableBody.innerHTML = `
          <tr>
            <td colspan="6" style="text-align: center; padding: 30px; color: #a3a3a3;">
              🔍 No hay palabras clave registradas para esta combinación de filtros. Prueba borrando el buscador o seleccionando 'Todas las Formas'.
            </td>
          </tr>
        `;
        return;
      }

      emTableBody.innerHTML = filtered.slice(0, 300).map(item => {
        let badgeClass = 'general';
        let badgeText = '💬 Nomenclatura';
        if (item.dim === 'marcas' || item.intent === 'marca') { badgeClass = 'especifico'; badgeText = '🏷️ Marca'; }
        else if (item.dim === 'materiales') { badgeClass = 'especifico'; badgeText = '🧱 Material'; }
        else if (item.dim === 'colores') { badgeClass = 'general'; badgeText = '🎨 Color'; }
        else if (item.dim === 'capacidades') { badgeClass = 'general'; badgeText = '📏 Medida'; }
        else if (item.dim === 'salud' || item.intent === 'informacional') { badgeClass = 'informacional'; badgeText = '🩺 Salud / FAQ'; }
        else if (item.intent === 'quickwin') { badgeClass = 'especifico'; badgeText = '🚀 Quick Win'; }
        else if (item.dim === 'brasieres' || item.dim === 'pantis' || item.dim === 'fajas') { badgeClass = 'especifico'; badgeText = `👙 ${item.dim}`; }
        else if (item.dim === 'chaquetas' || item.dim === 'abrigos') { badgeClass = 'especifico'; badgeText = `🧥 ${item.dim}`; }
        else if (item.dim === 'camisetas' || item.dim === 'polos' || item.dim === 'futbol_deporte') { badgeClass = 'especifico'; badgeText = `👕 ${item.dim}`; }
        else if (item.dim === 'hombre' || item.dim === 'mujer' || item.dim === 'smartwatch') { badgeClass = 'especifico'; badgeText = `⌚ ${item.dim}`; }

        return `
          <tr>
            <td><strong>${item.kw}</strong></td>
            <td><strong style="color: #ffffff;">${item.vol.toLocaleString('es-CO')}</strong></td>
            <td style="color: ${item.yoy.startsWith('+') ? '#1BAF7A' : '#ef4444'}; font-weight: 800;">${item.yoy}</td>
            <td><span class="keyword-tag">${item.comp}</span></td>
            <td><span class="intent-badge ${badgeClass}">${badgeText}</span></td>
            <td><span class="mapping-chip">${item.map}</span></td>
          </tr>
        `;
      }).join('');
    };

    // Dimension Pill listeners
    dimPills.forEach(pill => {
      pill.addEventListener('click', () => {
        dimPills.forEach(p => p.classList.remove('active'));
        pill.classList.add('active');
        activeDim = pill.getAttribute('data-dim');
        renderTable();
      });
    });

    // Sub-filters listeners
    if (subBrand) subBrand.addEventListener('change', renderTable);
    if (subMaterial) subMaterial.addEventListener('change', renderTable);
    if (subColor) subColor.addEventListener('change', renderTable);
    if (subCapacity) subCapacity.addEventListener('change', renderTable);
    if (emSearch) emSearch.addEventListener('input', renderTable);

    if (btnClearSearch) {
      btnClearSearch.addEventListener('click', () => {
        if (emSearch) emSearch.value = '';
        renderTable();
      });
    }

    const btnExportCSVMain = document.getElementById('btnExportCSVMain');
    if (btnExportCSVMain) {
      btnExportCSVMain.addEventListener('click', () => alert(`📊 Exportando dataset de ${currentCat} completo en CSV... ¡Descarga iniciada!`));
    }

    const btnCopyCatalogMain = document.getElementById('btnCopyCatalogMain');
    if (btnCopyCatalogMain) {
      btnCopyCatalogMain.addEventListener('click', () => alert('📋 Tabla copiada al portapapeles en formato OPCIÓN 3 listo para CatalogAI.'));
    }

    // Initial render
    setTimeout(() => {
      updateCharts('ollas');
      renderTable();
    }, 200);
  });
</script>
