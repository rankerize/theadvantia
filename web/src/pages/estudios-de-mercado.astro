      { kw: 'hoya de presion', vol: 170, yoy: '-19%', comp: 'Alto', dim: 'nomenclatura', brand: 'all', mat: 'all', col: 'all', cap: '4 a 7', map: 'Filtro Sinónimo SEO' },

      // Marcas
      { kw: 'imusa sarten', vol: 5400, yoy: '-19%', comp: 'Alto', dim: 'marcas', brand: 'imusa', mat: 'antiadherente', col: 'all', cap: 'all', map: 'Módulo 7 (Pareja 1)' },
      { kw: 'sartenes imusa', vol: 5400, yoy: '-19%', comp: 'Alto', dim: 'marcas', brand: 'imusa', mat: 'antiadherente', col: 'all', cap: 'all', map: 'Módulo 7 (Pareja 1)' },
      { kw: 'olla a presion universal', vol: 5400, yoy: '0%', comp: 'Alto', dim: 'marcas', brand: 'universal', mat: 'aluminio', col: 'all', cap: '4 a 7', map: 'Módulo 7 (Pareja 1)' },
      { kw: 'universal ollas', vol: 4400, yoy: '0%', comp: 'Alto', dim: 'marcas', brand: 'universal', mat: 'all', col: 'all', cap: 'all', map: 'Título / Módulo 7' },
      { kw: 'imusa ollas', vol: 3600, yoy: '0%', comp: 'Alto', dim: 'marcas', brand: 'imusa', mat: 'all', col: 'all', cap: 'all', map: 'Título / Módulo 7' },
      { kw: 'olla a presion royal prestige', vol: 1900, yoy: '-34%', comp: 'Alto', dim: 'marcas', brand: 'royal prestige', mat: 'acero quirurgico', col: 'all', cap: '4 a 7', map: 'Módulo 7 (Pareja 2)' },
      { kw: 'sarten tramontina', vol: 590, yoy: '+233%', comp: 'Alto', dim: 'quickwins', brand: 'tramontina', mat: 'acero inoxidable', col: 'all', cap: 'all', map: '🚀 Quick Win / Pareja 1' },
      { kw: 'sartenes ninja', vol: 40, yoy: '+467%', comp: 'Alto', dim: 'quickwins', brand: 'ninja', mat: 'antiadherente', col: 'all', cap: 'all', map: '🚀 Quick Win / Pareja 2' },

      // Materiales
      { kw: 'sarten antiadherente', vol: 4400, yoy: '0%', comp: 'Alto', dim: 'materiales', brand: 'all', mat: 'antiadherente', col: 'all', cap: 'all', map: 'Módulo 7 (Pareja 1)' },
      { kw: 'sarten de hierro fundido', vol: 3600, yoy: '+22%', comp: 'Alto', dim: 'materiales', brand: 'all', mat: 'hierro fundido', col: 'all', cap: 'all', map: 'Módulo 7 (Pareja 2)' },
      { kw: 'sarten acero inoxidable', vol: 2400, yoy: '0%', comp: 'Alto', dim: 'materiales', brand: 'all', mat: 'acero inoxidable', col: 'all', cap: 'all', map: 'Módulo 7 (Pareja 2)' },
      { kw: 'sarten de ceramica', vol: 1600, yoy: '-21%', comp: 'Alto', dim: 'materiales', brand: 'all', mat: 'ceramica', col: 'all', cap: 'all', map: 'Módulo 7 (Pareja 3)' },
      { kw: 'olla de barro', vol: 880, yoy: '-18%', comp: 'Alto', dim: 'materiales', brand: 'all', mat: 'barro', col: 'all', cap: 'all', map: 'Sección Artesanal' },
      { kw: 'sartenes de titanio', vol: 170, yoy: '+555%', comp: 'Alto', dim: 'quickwins', brand: 'all', mat: 'titanio', col: 'all', cap: 'all', map: '🚀 Quick Win / Pareja 1' },

      // Capacidades & Medidas
      { kw: 'olla a presion 6 litros', vol: 880, yoy: '0%', comp: 'Alto', dim: 'capacidades', brand: 'imusa', mat: 'aluminio', col: 'all', cap: '4 a 7', map: 'Módulo 7 (Pareja 1)' },
      { kw: 'olla arrocera 1 libra', vol: 170, yoy: '0%', comp: 'Alto', dim: 'capacidades', brand: 'all', mat: 'all', col: 'all', cap: '1 a 3', map: 'Módulo 7 (Pareja 2)' },
      { kw: 'sarten 24 cm', vol: 50, yoy: '-29%', comp: 'Alto', dim: 'capacidades', brand: 'all', mat: 'all', col: 'all', cap: '20 a 30 cm', map: 'Atributos SKU' },
      { kw: 'olla 50 litros', vol: 50, yoy: '+133%', comp: 'Alto', dim: 'capacidades', brand: 'all', mat: 'aluminio', col: 'all', cap: '10 a 50', map: 'Línea Industrial' },

      // Colores & Estética
      { kw: 'ollas negras', vol: 70, yoy: '0%', comp: 'Alto', dim: 'colores', brand: 'all', mat: 'all', col: 'negro', cap: 'all', map: 'Variante Estética' },
      { kw: 'ollas rosadas', vol: 210, yoy: '+50%', comp: 'Alto', dim: 'colores', brand: 'all', mat: 'all', col: 'rosa', cap: 'all', map: 'Variante Estética' },
      { kw: 'olla blanca', vol: 50, yoy: '+40%', comp: 'Alto', dim: 'colores', brand: 'all', mat: 'all', col: 'blanco', cap: 'all', map: 'Variante Estética' },
      { kw: 'olla cobre', vol: 70, yoy: '+40%', comp: 'Alto', dim: 'colores', brand: 'all', mat: 'cobre', col: 'cobre', cap: 'all', map: 'Variante Estética' },

      // Salud & Preguntas
      { kw: 'el teflon es toxico', vol: 90, yoy: '-56%', comp: 'Bajo', dim: 'salud', brand: 'all', mat: 'antiadherente', col: 'all', cap: 'all', map: '🩺 Guía Salud / FAQ IA' },
      { kw: 'marcas de sartenes libres de toxicos', vol: 110, yoy: '-55%', comp: 'Alto', dim: 'salud', brand: 'all', mat: 'all', col: 'all', cap: 'all', map: '🩺 Guía Salud / FAQ IA' },
      { kw: 'mejores materiales para ollas', vol: 90, yoy: '-44%', comp: 'Alto', dim: 'salud', brand: 'all', mat: 'all', col: 'all', cap: 'all', map: '🩺 Guía Salud' },
      { kw: 'sartenes de cerámica ventajas y desventajas', vol: 110, yoy: '-36%', comp: 'Bajo', dim: 'salud', brand: 'all', mat: 'ceramica', col: 'all', cap: 'all', map: '🤖 FAQ para IA' }
    ];

    const emSearch = document.getElementById('emSearch');
    const btnClearSearch = document.getElementById('btnClearSearch');
    const dimPills = document.querySelectorAll('#dimensionPills .dim-pill');
    const subBrand = document.getElementById('subBrand');
    const subMaterial = document.getElementById('subMaterial');
    const subColor = document.getElementById('subColor');
    const subCapacity = document.getElementById('subCapacity');
    const emTableBody = document.getElementById('emTableBody');
    const statVolume = document.getElementById('statVolume');
    const statCount = document.getElementById('statCount');

    let activeDim = 'all';

    const renderTable = () => {
      if (!emTableBody) return;

      const searchVal = emSearch ? emSearch.value.toLowerCase().trim() : '';
      const brandVal = subBrand ? subBrand.value : 'all';
      const matVal = subMaterial ? subMaterial.value : 'all';
      const colorVal = subColor ? subColor.value : 'all';
      const capVal = subCapacity ? subCapacity.value : 'all';

      const filtered = RAW_DATASET.filter(item => {
        const matchDim = activeDim === 'all' || item.dim === activeDim || (activeDim === 'quickwins' && item.dim === 'quickwins');
        const matchSearch = !searchVal || item.kw.toLowerCase().includes(searchVal);
        const matchBrand = brandVal === 'all' || item.brand === brandVal;
        const matchMat = matVal === 'all' || item.mat === matVal;
        const matchColor = colorVal === 'all' || item.col === colorVal;
        const matchCap = capVal === 'all' || item.cap === capVal;

        return matchDim && matchSearch && matchBrand && matchMat && matchColor && matchCap;
      });

      const totalVol = filtered.reduce((acc, curr) => acc + curr.vol, 0);
      if (statVolume) statVolume.innerText = `${totalVol.toLocaleString('es-CO')}/mes`;
      if (statCount) statCount.innerText = filtered.length;

      if (filtered.length === 0) {
        emTableBody.innerHTML = `
          <tr>
            <td colspan="6" style="text-align: center; padding: 30px; color: #a3a3a3;">
              🔍 No hay palabras clave registradas para esta combinación de filtros. Prueba borrando el buscador o seleccionando 'Todas las Formas'.
            </td>
          </tr>
        `;
        return;
      }

      emTableBody.innerHTML = filtered.map(item => {
        let badgeClass = 'general';
        let badgeText = '💬 Nomenclatura';
        if (item.dim === 'marcas') { badgeClass = 'especifico'; badgeText = '🏷️ Marca'; }
        else if (item.dim === 'materiales') { badgeClass = 'especifico'; badgeText = '🧱 Material'; }
        else if (item.dim === 'colores') { badgeClass = 'general'; badgeText = '🎨 Color'; }
        else if (item.dim === 'capacidades') { badgeClass = 'general'; badgeText = '📏 Medida'; }
        else if (item.dim === 'salud') { badgeClass = 'informacional'; badgeText = '🩺 Salud / FAQ'; }
        else if (item.dim === 'quickwins') { badgeClass = 'especifico'; badgeText = '🚀 Quick Win'; }

        return `
          <tr>
            <td><strong>${item.kw}</strong></td>
            <td><strong style="color: #ffffff;">${item.vol.toLocaleString('es-CO')}</strong></td>
            <td style="color: ${item.yoy.startsWith('+') ? '#1BAF7A' : '#ef4444'}; font-weight: 800;">${item.yoy}</td>
            <td><span class="keyword-tag">${item.comp}</span></td>
            <td><span class="intent-badge ${badgeClass}">${badgeText}</span></td>
            <td><span class="mapping-chip">${item.map}</span></td>
          </tr>
        `;
      }).join('');
    };

    // Dimension Pill listeners
    dimPills.forEach(pill => {
      pill.addEventListener('click', () => {
        dimPills.forEach(p => p.classList.remove('active'));
        pill.classList.add('active');
        activeDim = pill.getAttribute('data-dim');
        renderTable();
      });
    });

    // Sub-filters listeners
    if (subBrand) subBrand.addEventListener('change', renderTable);
    if (subMaterial) subMaterial.addEventListener('change', renderTable);
    if (subColor) subColor.addEventListener('change', renderTable);
    if (subCapacity) subCapacity.addEventListener('change', renderTable);
    if (emSearch) emSearch.addEventListener('input', renderTable);

    if (btnClearSearch) {
      btnClearSearch.addEventListener('click', () => {
        if (emSearch) emSearch.value = '';
        renderTable();
      });
    }

    const btnExportCSVMain = document.getElementById('btnExportCSVMain');
    if (btnExportCSVMain) {
      btnExportCSVMain.addEventListener('click', () => alert('📊 Exportando dataset completo en CSV... ¡Descarga iniciada!'));
    }

    const btnCopyCatalogMain = document.getElementById('btnCopyCatalogMain');
    if (btnCopyCatalogMain) {
      btnCopyCatalogMain.addEventListener('click', () => alert('📋 Tabla copiada al portapapeles en formato OPCIÓN 3 listo para CatalogAI.'));
    }

    // Initial render
    renderTable();
  });
</script>
