---
import Base from '../layouts/Base.astro';

const seo = {
  title: 'Marketplaces Sync & Channel Connector | Advantia Hub',
  description: 'Conexión directa con APIs de Mercado Libre, Falabella Seller Center, Amazon SP-API y Homecenter para auditar, sincronizar y publicar atributos masivamente.',
  canonical: 'https://theadvantia.com/marketplaces-sync',
  robots: 'noindex, nofollow',
};
---

<Base seo={seo} active="/aplicativos">
  <main class="mod-main">

    <!-- Top Navigation Bar -->
    <header class="mod-nav">
      <div class="wrap mod-nav-in">
        <div class="mod-brand">
          <a href="/aplicativos" class="back-link">← Volver a Aplicativos</a>
          <span class="divider">|</span>
          <span class="nav-title">🛒 Marketplaces Sync & Channel Connector</span>
        </div>
        <div class="mod-nav-actions">
          <span class="live-pill">🟢 APIs Multicanal en Línea</span>
          <a href="/aplicativos" class="mod-btn btn-secondary sm">Portal de Aplicativos</a>
        </div>
      </div>
    </header>

    <!-- Hero Header -->
    <section class="mod-hero">
      <div class="wrap">
        <div class="hero-badge"><span class="pulse-dot"></span> VITRINA HUB CONNECTOR · PORT 3001</div>
        <h1 class="hero-title">Marketplaces Sync & Channel Connector</h1>
        <p class="hero-subtitle">
          Auditoría en tiempo real, sincronización bidireccional y publicación masiva de atributos para tus tiendas en Mercado Libre Colombia, Falabella Seller Center, Amazon SP-API y Homecenter.
        </p>
        <div class="hero-chips">
          <span class="chip">💛 Mercado Libre API</span>
          <span class="chip">💚 Falabella Seller Center</span>
          <span class="chip">🧡 Amazon SP-API</span>
          <span class="chip">💙 Homecenter Sodimac</span>
        </div>
      </div>
    </section>

    <!-- Main Workspace -->
    <section class="mod-workspace">
      <div class="wrap-wide">
        <div class="ws-grid">

          <!-- LEFT: Channels & Auditor -->
          <div class="ws-panel controls-panel">
            <div class="panel-header">
              <h2>Estado de Canales Conectados</h2>
              <span class="panel-tag">Sync Status: 4 Canales</span>
            </div>

            <div class="channels-matrix">
              <div class="channel-chip connected">
                <span class="ch-icon">💛</span>
                <div class="ch-info">
                  <strong>Mercado Libre Colombia</strong>
                  <small>24 SKUs sincronizados · Salud 98%</small>
                </div>
                <span class="ch-badge">Conectado</span>
              </div>

              <div class="channel-chip connected">
                <span class="ch-icon">💚</span>
                <div class="ch-info">
                  <strong>Falabella Seller Center</strong>
                  <small>18 SKUs con atributos validados</small>
                </div>
                <span class="ch-badge">Conectado</span>
              </div>

              <div class="channel-chip syncing">
                <span class="ch-icon">🧡</span>
                <div class="ch-info">
                  <strong>Amazon SP-API</strong>
                  <small>Sincronización periódica programada</small>
                </div>
                <span class="ch-badge warning">En Cola</span>
              </div>

              <div class="channel-chip connected">
                <span class="ch-icon">💙</span>
                <div class="ch-info">
                  <strong>Homecenter / Sodimac</strong>
                  <small>Catálogo B2B actualizado</small>
                </div>
                <span class="ch-badge">Conectado</span>
              </div>
            </div>

            <div class="form-group margin-top">
              <label for="skuLookup">Auditar Publicación por SKU o Item ID</label>
              <div class="input-with-button">
                <input type="text" id="skuLookup" value="MCO-984210492" class="mod-input" />
                <button class="mod-btn btn-primary" id="btnCheckListing">🔎 Auditar</button>
              </div>
            </div>

            <div class="actions-row margin-top">
              <button class="mod-btn btn-secondary full" onclick="alert('Iniciando sincronización completa de feeds en segundo plano...');">
                🔄 Forzar Sincronización Global
              </button>
            </div>

            <div class="info-box margin-top">
              <strong>💡 Microservicio en Puerto 3001</strong>: Este conector se comunica con <code>marketplaces-service</code> gestionando tokens OAuth2 renovables y mapeo de taxonomías entre plataformas.
            </div>
          </div>

          <!-- RIGHT: Output Stage -->
          <div class="ws-panel output-panel">
            <div class="panel-header">
              <h2>Diagnóstico de Publicación en Vivo</h2>
              <span class="panel-tag" id="auditHealth">Salud SEO: 96%</span>
            </div>

            <div class="output-stage">
              <div class="audit-card-full">
                <div class="audit-header-full">
                  <div>
                    <span class="sku-id">ITEM ID: MCO-984210492</span>
                    <h3 class="sku-name">Tenis Deportivos Hombre Runflex Transpirables</h3>
                  </div>
                  <div class="score-circle">96%</div>
                </div>

                <div class="audit-grid-items">
                  <div class="audit-item">
                    <span class="item-title">Calidad de Título (SEO)</span>
                    <span class="tag-success">✓ 58 Caracteres · Palabras Clave Óptimas</span>
                  </div>
                  <div class="audit-item">
                    <span class="item-title">Atributos Técnicos Obligatorios</span>
                    <span class="tag-success">✓ 14/14 Completos (Ficha al 100%)</span>
                  </div>
                  <div class="audit-item">
                    <span class="item-title">Fondo de Imagen Principal</span>
                    <span class="tag-success">✓ Fondo Blanco Puro (#FFFFFF) Validado</span>
                  </div>
                  <div class="audit-item">
                    <span class="item-title">Estado de Inventario & Precio</span>
                    <span class="tag-info">Sincronizado: $189.900 COP (Stock: 45)</span>
                  </div>
                </div>

                <div class="result-actions margin-top">
                  <button class="mod-btn btn-primary" onclick="alert('Actualizando atributos en Mercado Libre...');">⚡ Auto-reparar Atributos Faltantes</button>
                  <a href="/marketplaces" class="mod-btn btn-secondary" style="text-decoration: none;">Ver Estrategia SEO Marketplaces</a>
                </div>
              </div>
            </div>

            <!-- Sync Log -->
            <div class="log-box">
              <div class="log-header">
                <h3>Registro de Eventos Webhook</h3>
                <span class="log-live">● En vivo</span>
              </div>
              <div class="log-entries">
                <div class="log-entry"><code>21:04:12</code> [MeLi-Sync] Token de acceso verificado correctamente.</div>
                <div class="log-entry"><code>21:02:45</code> [Falabella] 18 SKUs procesados sin errores de catálogo.</div>
              </div>
            </div>

          </div>

        </div>
      </div>
    </section>

  </main>
</Base>

<style>
  .mod-main { background: #0B1F3A; color: #fff; min-height: 100vh; }

  /* NAV */
  .mod-nav { background: rgba(0,0,0,0.5); border-bottom: 1px solid rgba(255,255,255,0.08); padding: 12px 0; }
  .mod-nav-in { display: flex; justify-content: space-between; align-items: center; }
  .mod-brand { display: flex; align-items: center; gap: 12px; }
  .back-link { color: #B08D57; font-size: 13px; font-weight: 700; text-decoration: none; }
  .back-link:hover { text-decoration: underline; }
  .divider { color: rgba(255,255,255,0.2); }
  .nav-title { font-size: 13px; color: #d4d4d4; font-weight: 600; }
  .mod-nav-actions { display: flex; align-items: center; gap: 12px; }
  .live-pill { font-size: 11px; font-weight: 700; color: #1BAF7A; background: rgba(27,175,122,0.12); border: 1px solid rgba(27,175,122,0.3); padding: 3px 10px; border-radius: 9999px; }

  /* HERO */
  .mod-hero { padding: 48px 0 36px; background: radial-gradient(circle at 50% 0%, #1E2761 0%, #0B1F3A 70%); text-align: center; border-bottom: 1px solid rgba(255,255,255,0.06); }
  .hero-badge { display: inline-flex; align-items: center; gap: 8px; background: rgba(138,43,226,0.15); color: #c084fc; border: 1px solid rgba(138,43,226,0.3); padding: 5px 14px; border-radius: 9999px; font-size: 12px; font-weight: 700; margin-bottom: 14px; }
  .pulse-dot { width: 7px; height: 7px; background: #c084fc; border-radius: 50%; box-shadow: 0 0 7px #c084fc; }
  .hero-title { font-size: 36px; font-weight: 800; margin-bottom: 12px; }
  .hero-subtitle { max-width: 680px; margin: 0 auto 20px; font-size: 16px; color: #b3b3b3; line-height: 1.6; }
  .hero-chips { display: flex; justify-content: center; gap: 10px; flex-wrap: wrap; }
  .chip { background: rgba(255,255,255,0.07); border: 1px solid rgba(255,255,255,0.12); color: #d4d4d4; padding: 4px 12px; border-radius: 9999px; font-size: 12px; font-weight: 600; }

  /* WORKSPACE */
  .mod-workspace { padding: 36px 0 60px; }
  .wrap-wide { max-width: 1300px; margin: 0 auto; padding: 0 24px; }
  .ws-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; }
  @media (max-width: 900px) { .ws-grid { grid-template-columns: 1fr; } }

  .ws-panel { background: rgba(30,39,97,0.4); border: 1px solid rgba(255,255,255,0.1); border-radius: 16px; padding: 24px; }
  .panel-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; padding-bottom: 14px; border-bottom: 1px solid rgba(255,255,255,0.08); }
  .panel-header h2 { font-size: 16px; font-weight: 700; margin: 0; }
  .panel-tag { font-size: 11px; color: #838383; font-family: monospace; }

  /* CHANNELS MATRIX */
  .channels-matrix { display: flex; flex-direction: column; gap: 10px; }
  .channel-chip { background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255, 255, 255, 0.08); padding: 12px 14px; border-radius: 8px; display: flex; align-items: center; gap: 12px; }
  .ch-icon { font-size: 24px; }
  .ch-info { flex-grow: 1; display: flex; flex-direction: column; }
  .ch-info strong { font-size: 13px; color: #ffffff; }
  .ch-info small { font-size: 11px; color: #a3a3a3; margin-top: 2px; }
  .ch-badge { font-size: 11px; font-weight: 700; padding: 3px 8px; border-radius: 4px; background: rgba(27, 175, 122, 0.15); color: #1BAF7A; border: 1px solid rgba(27,175,122,0.3); }
  .ch-badge.warning { background: rgba(245, 158, 11, 0.15); color: #f59e0b; border: 1px solid rgba(245,158,11,0.3); }

  /* FORMS & INPUTS */
  .form-group { display: flex; flex-direction: column; gap: 5px; margin-bottom: 14px; }
  .form-group label { font-size: 12px; font-weight: 700; color: #d4d4d4; text-transform: uppercase; letter-spacing: 0.4px; }
  .margin-top { margin-top: 14px; }
  .mod-input { width: 100%; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.15); color: #fff; padding: 9px 12px; border-radius: 7px; font-size: 13px; outline: none; box-sizing: border-box; }
  .input-with-button { display: flex; gap: 8px; }

  /* BUTTONS */
  .mod-btn { padding: 9px 16px; border-radius: 7px; font-size: 13px; font-weight: 700; cursor: pointer; border: none; display: inline-flex; align-items: center; justify-content: center; gap: 6px; }
  .btn-primary { background: linear-gradient(135deg, #1E2761 0%, #B08D57 100%); color: #fff; }
  .btn-secondary { background: rgba(255,255,255,0.08); color: #fff; border: 1px solid rgba(255,255,255,0.15); }
  .btn-secondary:hover { background: rgba(255,255,255,0.14); }
  .btn-primary.full, .btn-secondary.full { width: 100%; justify-content: center; padding: 12px; font-size: 13px; }
  .mod-btn.sm { font-size: 11px; padding: 5px 10px; }

  /* INFO BOX */
  .info-box { background: rgba(138,43,226,0.08); border: 1px solid rgba(138,43,226,0.25); border-radius: 7px; padding: 10px 14px; font-size: 11px; color: #b3b3b3; line-height: 1.5; }
  .info-box strong { color: #c084fc; }
  .info-box code { color: #B08D57; }

  /* OUTPUT STAGE */
  .output-stage { background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.06); border-radius: 10px; padding: 20px; min-height: 280px; display: flex; flex-direction: column; justify-content: center; margin-bottom: 20px; }
  
  .audit-card-full { width: 100%; display: flex; flex-direction: column; gap: 16px; }
  .audit-header-full { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid rgba(255,255,255,0.08); padding-bottom: 12px; }
  .sku-id { font-size: 11px; color: #B08D57; font-weight: 700; }
  .sku-name { font-size: 16px; margin: 4px 0 0 0; color: #ffffff; }
  .score-circle { width: 48px; height: 48px; border-radius: 50%; background: rgba(27,175,122,0.15); border: 2px solid #1BAF7A; color: #1BAF7A; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 15px; }

  .audit-grid-items { display: flex; flex-direction: column; gap: 10px; }
  .audit-item { display: flex; justify-content: space-between; align-items: center; background: rgba(255,255,255,0.03); padding: 10px 12px; border-radius: 6px; font-size: 12px; }
  .item-title { color: #d4d4d4; }
  .tag-success { background: rgba(27, 175, 122, 0.15); color: #1BAF7A; font-weight: 600; padding: 3px 8px; border-radius: 4px; font-size: 11px; }
  .tag-info { background: rgba(255, 255, 255, 0.1); color: #d4d4d4; padding: 3px 8px; border-radius: 4px; font-size: 11px; }

  .result-actions { display: flex; gap: 10px; width: 100%; }

  /* LOG BOX */
  .log-box { background: rgba(0,0,0,0.4); border: 1px solid rgba(255,255,255,0.06); border-radius: 8px; padding: 12px; font-family: monospace; font-size: 11px; }
  .log-header { display: flex; justify-content: space-between; margin-bottom: 6px; font-size: 11px; color: #838383; }
  .log-header h3 { margin: 0; font-size: 11px; font-weight: 700; color: #a3a3a3; }
  .log-live { color: #1BAF7A; }
  .log-entries { display: flex; flex-direction: column; gap: 4px; color: #94a3b8; }
  .log-entry code { color: #B08D57; }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const btnCheck = document.getElementById('btnCheckListing');
    if (btnCheck) {
      btnCheck.addEventListener('click', () => {
        btnCheck.innerText = '🔎 Auditando...';
        btnCheck.disabled = true;
        setTimeout(() => {
          btnCheck.innerText = '🔎 Auditar';
          btnCheck.disabled = false;
          alert('✅ Publicación auditada con éxito. Salud SEO: 96% (14/14 Atributos completados).');
        }, 600);
      });
    }
  });
</script>
