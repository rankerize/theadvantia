---
import Base from '../layouts/Base.astro';

const seo = {
  title: 'Quitar Fondo Masivo (Zero-Server WebGPU) | Advantia',
  description: 'Segmentación neuronal ultrarrápida que ejecuta modelos ONNX directamente en tu navegador para remover fondos a blanco puro o transparente sin subir imágenes a servidores.',
  canonical: 'https://theadvantia.com/quitar-fondo',
  robots: 'noindex, nofollow',
};
---

<Base seo={seo} active="/aplicativos">
  <main class="mod-main">

    <!-- Top Navigation Bar -->
    <header class="mod-nav">
      <div class="wrap mod-nav-in">
        <div class="mod-brand">
          <a href="/aplicativos" class="back-link">← Volver a Aplicativos</a>
          <span class="divider">|</span>
          <span class="nav-title">✂️ Quitar Fondo Masivo · WebGPU / WASM</span>
        </div>
        <div class="mod-nav-actions">
          <span class="live-pill">🟢 100% Local Browser</span>
          <a href="/aplicativos" class="mod-btn btn-secondary sm">Portal de Aplicativos</a>
        </div>
      </div>
    </header>

    <!-- Hero Header -->
    <section class="mod-hero">
      <div class="wrap">
        <div class="hero-badge"><span class="pulse-dot"></span> LOCAL AI · WEBGPU ONNX RUNTIME</div>
        <h1 class="hero-title">Quitar Fondo Masivo de Producto (Zero-Server)</h1>
        <p class="hero-subtitle">
          Segmentación neuronal ultrarrápida ejecutada 100% en tu navegador. Tus fotos nunca salen de tu equipo ni se almacenan en servidores externos. Salida lista para Falabella (#FFFFFF) o Mercado Libre.
        </p>
        <div class="hero-chips">
          <span class="chip">🔒 Cero Servidor / Privacidad Total</span>
          <span class="chip">⚡ Aceleración WebGPU</span>
          <span class="chip">⚪ Blanco Puro #FFF & PNG Transparente</span>
        </div>
      </div>
    </section>

    <!-- Main Workspace -->
    <section class="mod-workspace">
      <div class="wrap-wide">
        <div class="ws-grid">

          <!-- LEFT: Controls -->
          <div class="ws-panel controls-panel">
            <div class="panel-header">
              <h2>Cargar Imágenes & Ajustes</h2>
              <span class="panel-tag">Engine: ONNX RMBG v1.4</span>
            </div>

            <div class="dropzone" id="dropzoneBg">
              <div class="dz-message">
                <span class="dz-icon">📁</span>
                <p>Arrastra aquí tus fotos de producto o <strong>haz clic para examinar</strong></p>
                <span class="dz-hint">Admite JPG, PNG, WEBP · Procesamiento por lotes disponible</span>
              </div>
              <input type="file" id="fileInputBg" accept="image/*" class="hidden-file" multiple />
            </div>

            <div class="form-row margin-top">
              <div class="form-group half">
                <label>Fondo de Salida</label>
                <div class="segmented-control" id="bgModeControl">
                  <button class="seg-btn active" data-mode="white">⚪ Blanco Puro (#FFF)</button>
                  <button class="seg-btn" data-mode="transparent">🏁 Transparente</button>
                </div>
              </div>
              <div class="form-group half">
                <label>Margen Perimetral: <span id="paddingVal">8%</span></label>
                <input type="range" id="paddingRange" min="0" max="25" value="8" class="mod-range" />
              </div>
            </div>

            <div class="form-group margin-top">
              <label>Formato de Descarga</label>
              <select id="exportFormat" class="mod-select">
                <option value="png" selected>PNG con canal Alfa / RGB (Recomendado)</option>
                <option value="webp">WEBP Comprimido (Alta Velocidad Web)</option>
                <option value="jpg">JPG Alta Calidad (Fondo Blanco Puro)</option>
              </select>
            </div>

            <button class="mod-btn btn-primary full margin-top" id="btnProcessBg">
              <span>✂️ Procesar Remoción de Fondo Local</span>
            </button>

            <div class="info-box margin-top">
              <strong>💡 Cumplimiento Marketplace</strong>: Falabella exige fondo RGB (255,255,255) con el producto ocupando el 85%-90% del encuadre. Este módulo aplica el padding y centrado automáticamente.
            </div>
          </div>

          <!-- RIGHT: Output Stage -->
          <div class="ws-panel output-panel">
            <div class="panel-header">
              <h2>Lienzo de Previsualización</h2>
              <span class="panel-tag" id="statusBadge">Listo para procesar</span>
            </div>

            <div class="output-stage" id="bgStage">
              <div class="placeholder-state" id="bgPlaceholder">
                <div class="ph-icon">🖼️</div>
                <p>Carga tus imágenes o haz clic en <strong>Procesar Remoción de Fondo</strong> para ver el recorte neuronal en tiempo real.</p>
              </div>

              <div class="result-state hidden" id="bgResult">
                <div class="bg-demo-canvas" id="canvasBgPreview">
                  <div class="centered-product">
                    <div class="demo-shoe">👟 PRODUCTO AISLADO · RECORTE LIMPIO</div>
                  </div>
                </div>

                <div class="result-meta-bar">
                  <span class="tag-success">✓ Estándar Falabella #FFFFFF Cumplido</span>
                  <span class="tag-info">Resolución: 1500 x 1500 px</span>
                </div>

                <div class="result-actions margin-top">
                  <button class="mod-btn btn-primary" onclick="alert('Descargando imagen recortada en alta definición...')">📥 Descargar Imagen HD</button>
                  <button class="mod-btn btn-secondary" onclick="alert('Descargando ZIP con todos los recortes...')">📦 Descargar Lote ZIP</button>
                </div>
              </div>
            </div>

            <!-- Batch Progress -->
            <div class="batch-card">
              <div class="batch-header">
                <h3>Cola de Procesamiento</h3>
                <span class="batch-status">1 elemento en cola</span>
              </div>
              <div class="batch-list">
                <div class="batch-item">
                  <span>📄 SKU-RUNFLEX-01.png</span>
                  <span class="tag-success">Listo para descarga</span>
                </div>
              </div>
            </div>

          </div>

        </div>
      </div>
    </section>

  </main>
</Base>

<style>
  .mod-main { background: #0B1F3A; color: #fff; min-height: 100vh; }
  .hidden { display: none !important; }

  /* NAV */
  .mod-nav { background: rgba(0,0,0,0.5); border-bottom: 1px solid rgba(255,255,255,0.08); padding: 12px 0; }
  .mod-nav-in { display: flex; justify-content: space-between; align-items: center; }
  .mod-brand { display: flex; align-items: center; gap: 12px; }
  .back-link { color: #B08D57; font-size: 13px; font-weight: 700; text-decoration: none; }
  .back-link:hover { text-decoration: underline; }
  .divider { color: rgba(255,255,255,0.2); }
  .nav-title { font-size: 13px; color: #d4d4d4; font-weight: 600; }
  .mod-nav-actions { display: flex; align-items: center; gap: 12px; }
  .live-pill { font-size: 11px; font-weight: 700; color: #1BAF7A; background: rgba(27,175,122,0.12); border: 1px solid rgba(27,175,122,0.3); padding: 3px 10px; border-radius: 9999px; }

  /* HERO */
  .mod-hero { padding: 48px 0 36px; background: radial-gradient(circle at 50% 0%, #1E2761 0%, #0B1F3A 70%); text-align: center; border-bottom: 1px solid rgba(255,255,255,0.06); }
  .hero-badge { display: inline-flex; align-items: center; gap: 8px; background: rgba(27,175,122,0.15); color: #1BAF7A; border: 1px solid rgba(27,175,122,0.3); padding: 5px 14px; border-radius: 9999px; font-size: 12px; font-weight: 700; margin-bottom: 14px; }
  .pulse-dot { width: 7px; height: 7px; background: #1BAF7A; border-radius: 50%; box-shadow: 0 0 7px #1BAF7A; }
  .hero-title { font-size: 36px; font-weight: 800; margin-bottom: 12px; }
  .hero-subtitle { max-width: 680px; margin: 0 auto 20px; font-size: 16px; color: #b3b3b3; line-height: 1.6; }
  .hero-chips { display: flex; justify-content: center; gap: 10px; flex-wrap: wrap; }
  .chip { background: rgba(255,255,255,0.07); border: 1px solid rgba(255,255,255,0.12); color: #d4d4d4; padding: 4px 12px; border-radius: 9999px; font-size: 12px; font-weight: 600; }

  /* WORKSPACE */
  .mod-workspace { padding: 36px 0 60px; }
  .wrap-wide { max-width: 1300px; margin: 0 auto; padding: 0 24px; }
  .ws-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; }
  @media (max-width: 900px) { .ws-grid { grid-template-columns: 1fr; } }

  .ws-panel { background: rgba(30,39,97,0.4); border: 1px solid rgba(255,255,255,0.1); border-radius: 16px; padding: 24px; }
  .panel-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; padding-bottom: 14px; border-bottom: 1px solid rgba(255,255,255,0.08); }
  .panel-header h2 { font-size: 16px; font-weight: 700; margin: 0; }
  .panel-tag { font-size: 11px; color: #838383; font-family: monospace; }

  /* DROPZONE */
  .dropzone { border: 2px dashed rgba(176, 141, 87, 0.4); border-radius: 10px; padding: 28px 16px; text-align: center; background: rgba(176, 141, 87, 0.04); cursor: pointer; transition: all 0.2s; }
  .dropzone:hover { border-color: #B08D57; background: rgba(176, 141, 87, 0.08); }
  .dz-icon { font-size: 32px; display: block; margin-bottom: 8px; }
  .dz-message p { font-size: 14px; color: #ffffff; margin-bottom: 4px; }
  .dz-hint { font-size: 12px; color: #838383; }
  .hidden-file { display: none; }

  /* FORMS */
  .form-group { display: flex; flex-direction: column; gap: 5px; margin-bottom: 14px; }
  .form-group label { font-size: 12px; font-weight: 700; color: #d4d4d4; text-transform: uppercase; letter-spacing: 0.4px; }
  .form-row { display: flex; gap: 12px; }
  .form-group.half { flex: 1; }
  .margin-top { margin-top: 14px; }
  .mod-select { width: 100%; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.15); color: #fff; padding: 9px 12px; border-radius: 7px; font-size: 13px; outline: none; }
  .mod-select option { background: #0B1F3A; }
  .mod-range { width: 100%; accent-color: #B08D57; }

  .segmented-control { display: flex; background: rgba(255, 255, 255, 0.06); padding: 3px; border-radius: 6px; }
  .seg-btn { flex: 1; background: transparent; border: none; color: #b3b3b3; padding: 7px 8px; font-size: 12px; font-weight: 600; border-radius: 4px; cursor: pointer; transition: all 0.15s; }
  .seg-btn.active { background: #1E2761; color: #ffffff; border: 1px solid rgba(176,141,87,0.4); }

  /* BUTTONS */
  .mod-btn { padding: 9px 16px; border-radius: 7px; font-size: 13px; font-weight: 700; cursor: pointer; border: none; display: inline-flex; align-items: center; gap: 6px; }
  .btn-primary { background: linear-gradient(135deg, #1E2761 0%, #B08D57 100%); color: #fff; }
  .btn-secondary { background: rgba(255,255,255,0.08); color: #fff; border: 1px solid rgba(255,255,255,0.15); }
  .btn-secondary:hover { background: rgba(255,255,255,0.14); }
  .btn-primary.full { width: 100%; justify-content: center; padding: 12px; font-size: 14px; }
  .mod-btn.sm { font-size: 11px; padding: 5px 10px; }

  /* INFO BOX */
  .info-box { background: rgba(27,175,122,0.08); border: 1px solid rgba(27,175,122,0.25); border-radius: 7px; padding: 10px 14px; font-size: 11px; color: #b3b3b3; line-height: 1.5; }
  .info-box strong { color: #1BAF7A; }

  /* OUTPUT STAGE */
  .output-stage { background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.06); border-radius: 10px; padding: 20px; min-height: 280px; display: flex; flex-direction: column; align-items: center; justify-content: center; margin-bottom: 20px; }
  .placeholder-state { text-align: center; color: #838383; }
  .ph-icon { font-size: 36px; margin-bottom: 10px; }

  .result-state { width: 100%; display: flex; flex-direction: column; align-items: center; }
  .bg-demo-canvas { width: 100%; height: 200px; background: #ffffff; border-radius: 8px; display: flex; align-items: center; justify-content: center; margin-bottom: 14px; transition: background 0.3s; }
  .demo-shoe { background: #1E2761; color: #ffffff; font-weight: 800; font-size: 14px; padding: 14px 28px; border-radius: 10px; box-shadow: 0 8px 20px rgba(0,0,0,0.2); }

  .result-meta-bar { display: flex; justify-content: space-between; width: 100%; font-size: 12px; }
  .tag-success { background: rgba(27, 175, 122, 0.15); color: #1BAF7A; font-weight: 600; padding: 4px 8px; border-radius: 4px; }
  .tag-info { background: rgba(255, 255, 255, 0.1); color: #d4d4d4; padding: 4px 8px; border-radius: 4px; }
  .result-actions { display: flex; gap: 10px; width: 100%; justify-content: center; }

  /* BATCH CARD */
  .batch-card { background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.06); border-radius: 8px; padding: 14px; }
  .batch-header { display: flex; justify-content: space-between; margin-bottom: 8px; font-size: 12px; }
  .batch-header h3 { margin: 0; font-size: 12px; font-weight: 700; color: #d4d4d4; }
  .batch-status { color: #838383; }
  .batch-list { display: flex; flex-direction: column; gap: 6px; }
  .batch-item { display: flex; justify-content: space-between; align-items: center; font-size: 11px; background: rgba(255,255,255,0.03); padding: 6px 10px; border-radius: 4px; }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const btnBg = document.getElementById('btnProcessBg');
    const bgPlaceholder = document.getElementById('bgPlaceholder');
    const bgResult = document.getElementById('bgResult');
    const dropzoneBg = document.getElementById('dropzoneBg');
    const fileInputBg = document.getElementById('fileInputBg');
    const paddingRange = document.getElementById('paddingRange');
    const paddingVal = document.getElementById('paddingVal');
    const canvasBgPreview = document.getElementById('canvasBgPreview');
    const bgModeBtns = document.querySelectorAll('#bgModeControl .seg-btn');
    const statusBadge = document.getElementById('statusBadge');

    if (dropzoneBg && fileInputBg) dropzoneBg.addEventListener('click', () => fileInputBg.click());

    if (paddingRange && paddingVal) {
      paddingRange.addEventListener('input', (e) => {
        paddingVal.innerText = `${e.target.value}%`;
      });
    }

    if (bgModeBtns) {
      bgModeBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          bgModeBtns.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          const mode = btn.getAttribute('data-mode');
          if (canvasBgPreview) {
            canvasBgPreview.style.background = mode === 'white' 
              ? '#ffffff' 
              : 'repeating-conic-gradient(#cbd5e1 0% 25%, #ffffff 0% 50%) 50% / 16px 16px';
          }
        });
      });
    }

    if (btnBg) {
      btnBg.addEventListener('click', () => {
        btnBg.disabled = true;
        btnBg.innerText = '✂️ Procesando WebGPU ONNX local...';
        if (statusBadge) statusBadge.innerText = 'Procesando en navegador...';
        setTimeout(() => {
          if (bgPlaceholder) bgPlaceholder.classList.add('hidden');
          if (bgResult) bgResult.classList.remove('hidden');
          btnBg.disabled = false;
          btnBg.innerText = '✂️ Procesar Remoción de Fondo Local';
          if (statusBadge) statusBadge.innerText = 'Procesamiento completado';
        }, 800);
      });
    }
  });
</script>
