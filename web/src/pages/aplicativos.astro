---
import Base from '../layouts/Base.astro';

const seo = {
  title: 'Portal de Aplicativos & Herramientas IA | ADVANTIA',
  description: 'Acceso directo a la suite de aplicativos y microservicios de IA de Advantia: Estudios de Mercado, Flux AI, Remoción de Fondo WebGPU, CatalogAI y Marketplaces Sync.',
  canonical: 'https://theadvantia.com/aplicativos',
  robots: 'noindex, nofollow',
};

const modules = [
  {
    id: 'estudios-de-mercado',
    name: 'Estudios de Mercado & Demanda SEO',
    category: 'market-research',
    tag: 'CATALOG-AI MARKET INTELLIGENCE',
    icon: '📊',
    status: 'Dataset 2026 Activo',
    desc: 'Explora y desagrega la demanda real de búsqueda de compradores en Colombia por marcas, materiales, capacidades y dudas de salud para optimizar con CatalogAI.',
    href: '/estudios-de-mercado',
    badges: ['Google Keyword Planner', 'Clusters Semánticos', 'Quick Wins']
  },
  {
    id: 'crear-imagenes',
    name: 'Crear Imágenes de Producto (Flux AI)',
    category: 'images',
    tag: 'FLUX / ATENEA AI WORKER',
    icon: '🎨',
    status: 'Engine Flash Activo',
    desc: 'Genera ambientaciones fotorrealistas en 4K y fondos publicitarios conservando el 100% de la identidad de tu SKU con Gemini Flash Image y Atenea Studio.',
    href: '/crear-imagenes',
    badges: ['4K Fotorrealista', 'Gemini Flash Image', 'Falabella / MeLi Standard']
  },
  {
    id: 'quitar-fondo',
    name: 'Quitar Fondo Masivo (Zero-Server)',
    category: 'images',
    tag: 'LOCAL AI · WEBGPU / WASM',
    icon: '✂️',
    status: '100% Local Browser',
    desc: 'Segmentación neuronal ultrarrápida ejecutada directamente en tu navegador sin subir imágenes a servidores. Salida a Fondo Blanco (#FFFFFF) o PNG Transparente.',
    href: '/quitar-fondo',
    badges: ['ONNX WebGPU', 'Privacidad Total', 'Fondo Blanco #FFFFFF']
  },
  {
    id: 'descripcion-producto',
    name: 'Descripción de Producto & Títulos SEO',
    category: 'catalog',
    tag: 'CATALOG-AI PROTOCOL',
    icon: '📝',
    status: 'Protocolo v4.2',
    desc: 'Generador inteligente de títulos estructurados a 60 caracteres, viñetas persuasivas de alto impacto y atributos técnicos para el SEO de Mercado Libre y Falabella.',
    href: '/descripcion-producto',
    badges: ['SEO 60 Caracteres', 'Bullet Points Persuasivos', 'Inyección Atributos']
  },
  {
    id: 'marketplaces-sync',
    name: 'Marketplaces Sync & Channel Connector',
    category: 'marketplaces',
    tag: 'VITRINA HUB CONNECTOR',
    icon: '🛒',
    status: 'APIs Multicanal',
    desc: 'Conexión y auditoría en tiempo real con las APIs de Mercado Libre, Falabella Seller Center, Amazon SP-API y Homecenter para publicar atributos y auditar salud.',
    href: '/marketplaces-sync',
    badges: ['Mercado Libre API', 'Falabella Seller', 'Auditor de Salud SEO']
  }
];
---

<Base seo={seo} active="/aplicativos">
  <main class="portal-main">

    <!-- Top Session Bar -->
    <div class="session-bar">
      <div class="wrap session-in">
        <div class="session-info">
          <span class="user-badge">👤 Acceso de equipo</span>
          <span class="status-pill active">🟢 Sesión Activa</span>
        </div>
        <div class="session-right">
          <span class="session-tag">5 Módulos Disponibles</span>
        </div>
      </div>
    </div>

    <!-- Hero Header -->
    <section class="portal-hero">
      <div class="wrap">
        <div class="portal-badge">
          <span class="pulse-dot"></span>
          ADVANTIA AI SUITE · PORTAL DE APLICATIVOS
        </div>
        <h1 class="portal-title">Módulos & Herramientas IA</h1>
        <p class="portal-subtitle">
          Selecciona un aplicativo para abrir su espacio de trabajo y ejecutar optimizaciones de catálogo, generación visual o sincronización de canales.
        </p>

        <!-- Category Filters -->
        <div class="filter-tabs" id="filterTabs">
          <button class="tab-btn active" data-filter="all">Todos los Módulos (5)</button>
          <button class="tab-btn" data-filter="market-research">📊 Estudios de Mercado</button>
          <button class="tab-btn" data-filter="images">🎨 Imágenes & Visuales</button>
          <button class="tab-btn" data-filter="catalog">📝 Catálogo & SEO</button>
          <button class="tab-btn" data-filter="marketplaces">🛒 Marketplaces Sync</button>
        </div>

      </div>
    </section>

    <!-- Apps Hub Grid -->
    <section class="portal-grid-section">
      <div class="wrap">
        <div class="apps-hub-grid" id="appsGrid">
          {modules.map((mod) => (
            <a href={mod.href} class="module-card" data-category={mod.category} id={`card-${mod.id}`}>
              <div class="card-inner">
                
                <div class="card-top">
                  <div class="module-icon-box">
                    <span class="module-emoji">{mod.icon}</span>
                  </div>
                  <div class="card-status-badge">
                    <span class="status-indicator"></span>
                    <span>{mod.status}</span>
                  </div>
                </div>

                <div class="card-content">
                  <span class="module-tag">{mod.tag}</span>
                  <h2 class="module-title">{mod.name}</h2>
                  <p class="module-desc">{mod.desc}</p>
                </div>

                <div class="card-chips">
                  {mod.badges.map((b) => (
                    <span class="mini-chip">{b}</span>
                  ))}
                </div>

                <div class="card-footer">
                  <span class="open-btn">
                    <span>Abrir Módulo</span>
                    <span class="arrow-icon">→</span>
                  </span>
                </div>

              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

  </main>
</Base>

<style is:global>
  /* ==========================================================================
     ADVANTIA · PORTAL DE APLICATIVOS (Colores Oficiales de Marca)
     Fondo: #0B1F3A / #1E2761 · Acento: #B08D57 (Dorado) · Verde: #1BAF7A
     ========================================================================== */

  .portal-main {
    background: #0B1F3A !important;
    color: #ffffff !important;
    min-height: 100vh;
    padding-bottom: 90px;
    font-family: var(--font-body, system-ui, -apple-system, sans-serif);
  }

  /* 1. TOP SESSION BAR */
  .session-bar {
    background: rgba(0, 0, 0, 0.45);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding: 12px 0;
  }

  .session-in {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .session-info {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .user-badge {
    font-size: 13px;
    color: #d4d4d4 !important;
  }

  .session-tag {
    font-size: 12px;
    color: #B08D57 !important;
    font-weight: 600;
  }

  .status-pill {
    font-size: 11px;
    font-weight: 600;
    padding: 3px 10px;
    border-radius: 9999px;
    background: rgba(27, 175, 122, 0.15);
    color: #1BAF7A !important;
    border: 1px solid rgba(27, 175, 122, 0.3);
  }

  /* 2. PORTAL HERO */
  .portal-hero {
    background: radial-gradient(circle at 50% 0%, #1E2761 0%, #0B1F3A 75%);
    padding: 56px 0 36px 0;
    text-align: center;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .portal-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(176, 141, 87, 0.15);
    color: #B08D57 !important;
    border: 1px solid rgba(176, 141, 87, 0.3);
    padding: 6px 18px;
    border-radius: 9999px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.5px;
    margin-bottom: 18px;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    background: #1BAF7A;
    border-radius: 50%;
    box-shadow: 0 0 8px #1BAF7A;
  }

  .portal-title {
    font-family: var(--font-display, inherit);
    font-size: 40px !important;
    font-weight: 800 !important;
    color: #ffffff !important;
    margin: 0 0 14px 0 !important;
    letter-spacing: -0.5px;
  }

  @media (max-width: 768px) {
    .portal-title {
      font-size: 28px !important;
    }
  }

  .portal-subtitle {
    max-width: 680px;
    margin: 0 auto 32px auto;
    font-size: 16px !important;
    color: #cbd5e1 !important;
    line-height: 1.6;
  }

  .filter-tabs {
    display: flex;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .tab-btn {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #d4d4d4 !important;
    padding: 8px 18px;
    border-radius: 9999px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .tab-btn:hover {
    background: rgba(255, 255, 255, 0.1);
    color: #ffffff !important;
    border-color: rgba(255, 255, 255, 0.25);
  }

  .tab-btn.active {
    background: #B08D57 !important;
    color: #ffffff !important;
    border-color: #B08D57 !important;
    box-shadow: 0 4px 14px rgba(176, 141, 87, 0.35);
  }

  /* 3. APPS GRID */
  .portal-grid-section {
    padding-top: 40px;
  }

  .apps-hub-grid {
    display: grid !important;
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr)) !important;
    gap: 24px !important;
  }

  @media (max-width: 640px) {
    .apps-hub-grid {
      grid-template-columns: 1fr !important;
    }
  }

  /* 4. MODULE CARD (Superficie limpia en paleta oficial) */
  .module-card {
    display: flex !important;
    text-decoration: none !important;
    color: #ffffff !important;
    background: #12213F !important;
    border: 1px solid rgba(255, 255, 255, 0.12) !important;
    border-radius: 16px !important;
    padding: 26px !important;
    position: relative;
    overflow: hidden;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease !important;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
  }

  .module-card:hover {
    transform: translateY(-4px);
    border-color: rgba(176, 141, 87, 0.6) !important;
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.4), 0 0 20px rgba(176, 141, 87, 0.15) !important;
  }

  .card-inner {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  /* CARD TOP */
  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 18px;
  }

  .module-icon-box {
    width: 52px;
    height: 52px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    transition: transform 0.2s ease;
  }

  .module-card:hover .module-icon-box {
    transform: scale(1.06);
    border-color: #B08D57;
  }

  .module-emoji {
    font-size: 26px;
    line-height: 1;
  }

  .card-status-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 9999px;
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #d4d4d4 !important;
  }

  .status-indicator {
    width: 6px;
    height: 6px;
    background: #1BAF7A;
    border-radius: 50%;
    box-shadow: 0 0 6px #1BAF7A;
  }

  /* CARD CONTENT */
  .card-content {
    flex-grow: 1;
    margin-bottom: 18px;
  }

  .module-tag {
    font-size: 11px;
    font-weight: 700;
    color: #B08D57 !important;
    letter-spacing: 0.5px;
    display: block;
    margin-bottom: 6px;
    text-transform: uppercase;
  }

  .module-title {
    font-family: var(--font-display, inherit);
    font-size: 20px !important;
    font-weight: 700 !important;
    color: #ffffff !important;
    margin: 0 0 10px 0 !important;
    line-height: 1.3 !important;
  }

  .module-desc {
    font-size: 13.5px !important;
    color: #cbd5e1 !important;
    line-height: 1.55 !important;
    margin: 0 !important;
  }

  /* CHIPS */
  .card-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 20px;
  }

  .mini-chip {
    font-size: 11px;
    background: rgba(0, 0, 0, 0.25);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #cbd5e1 !important;
    padding: 3px 8px;
    border-radius: 6px;
  }

  /* CARD FOOTER */
  .card-footer {
    padding-top: 14px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .open-btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    font-size: 13px;
    font-weight: 700;
    color: #ffffff !important;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    padding: 10px 16px;
    border-radius: 8px;
    transition: all 0.2s ease;
  }

  .arrow-icon {
    font-size: 15px;
    transition: transform 0.2s ease;
  }

  .module-card:hover .open-btn {
    background: #B08D57 !important;
    border-color: #B08D57 !important;
    color: #ffffff !important;
  }

  .module-card:hover .arrow-icon {
    transform: translateX(4px);
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // Category Filter Tabs
    const tabs = document.querySelectorAll('#filterTabs .tab-btn');
    const cards = document.querySelectorAll('#appsGrid .module-card');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        const filter = tab.getAttribute('data-filter');
        
        cards.forEach(card => {
          if (filter === 'all' || card.getAttribute('data-category') === filter) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  });
</script>
