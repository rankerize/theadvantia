---
import Base from '../layouts/Base.astro';

const seo = {
  title: 'Portal de Herramientas & Microservicios IA | ADVANTIA',
  description: 'Portal de acceso a las soluciones de IA de Advantia: Estudios de Mercado, Flux AI, Remoción de Fondo WebGPU, CatalogAI y Marketplaces Sync.',
  canonical: 'https://theadvantia.com/aplicativos',
  robots: 'noindex, nofollow',
};

const modules = [
  {
    id: 'flux',
    name: 'Crear Imágenes de Producto (Flux AI)',
    category: 'images',
    tag: 'FLUX / ATENEA AI WORKER',
    icon: '🎨',
    glowClass: 'gold-glow',
    status: '🟢 Servicio Activo',
    desc: 'Genera ambientaciones fotorrealistas en 4K, cambios de escena y fondos publicitarios conservando el 100% de la identidad de tu SKU con Gemini 3.1 Flash Image y Atenea Studio.',
    href: '/crear-imagenes',
    badges: ['Gemini Flash Image', 'Resolución 4K', 'Estándar Falabella / MeLi'],
    ctaText: 'Abrir Creador de Imágenes'
  },
  {
    id: 'bg-remove',
    name: 'Quitar Fondo Masivo (Zero-Server)',
    category: 'images',
    tag: 'LOCAL AI · WEBGPU / WASM',
    icon: '✂️',
    glowClass: 'green-glow',
    status: '🟢 100% Local Browser',
    desc: 'Segmentación neuronal ultrarrápida ejecutada directamente en tu navegador sin subir imágenes a servidores. Elimina fondos a Blanco Puro (#FFFFFF) o PNG Transparente.',
    href: '/quitar-fondo',
    badges: ['ONNX Runtime WebGPU', 'Privacidad Total', 'Lotes Masivos ZIP'],
    ctaText: 'Abrir Removedor de Fondo'
  },
  {
    id: 'catalog-desc',
    name: 'Descripción de Producto & Títulos SEO',
    category: 'catalog',
    tag: 'CATALOG-AI PROTOCOL',
    icon: '📝',
    glowClass: 'blue-glow',
    status: '🟢 Protocolo v4.2 Activo',
    desc: 'Generador masivo de títulos optimizados a 60 caracteres, viñetas persuasivas de alto impacto y atributos estructurados para los algoritmos de Mercado Libre, Falabella y Amazon.',
    href: '/descripcion-producto',
    badges: ['SEO 60 Caracteres', 'Bullet Points Persuasivos', 'Inyección Atributos'],
    ctaText: 'Abrir Generador CatalogAI'
  },
  {
    id: 'marketplaces-sync',
    name: 'Marketplaces Sync & Channel Connector',
    category: 'marketplaces',
    tag: 'VITRINA HUB CONNECTOR',
    icon: '🛒',
    glowClass: 'purple-glow',
    status: '🟢 APIs en Línea',
    desc: 'Conexión directa con las APIs oficiales de Mercado Libre, Falabella Seller Center, Amazon SP-API y Homecenter para auditar, sincronizar y publicar atributos masivamente.',
    href: '/marketplaces-sync',
    badges: ['Mercado Libre API', 'Falabella Seller Center', 'Auditor de Salud SEO'],
    ctaText: 'Abrir Conector Multicanal'
  },
  {
    id: 'market-research',
    name: 'Estudios de Mercado & Búsquedas por Categoría',
    category: 'market-research',
    tag: 'CATALOG-AI MARKET INTELLIGENCE',
    icon: '📊',
    glowClass: 'amber-glow',
    status: '🟢 Dataset 2026 Actualizado',
    desc: 'Explora y desagrega el comportamiento real de búsqueda de los compradores en Colombia (Google Keyword Planner & Marketplace Volume). Filtra por clusters, intención y Quick Wins.',
    href: '/estudios-de-mercado',
    badges: ['Dataset Colombia 2026', '+250k Búsquedas/Mes', 'Clusters Semánticos'],
    ctaText: 'Abrir Explorador de Mercado'
  }
];
---

<Base seo={seo} active="/aplicativos">
  <main class="portal-main">

    <!-- Top Session Bar -->
    <div class="session-bar">
      <div class="wrap session-in">
        <div class="session-info">
          <span class="user-badge">👤 Usuario Autorizado: <strong>equipo@advantia.com</strong></span>
          <span class="status-pill active">🟢 Sesión Activa</span>
        </div>
        <div class="session-actions">
          <span class="modules-count-pill">5 Módulos Disponibles</span>
        </div>
      </div>
    </div>

    <!-- Hero Header -->
    <section class="portal-hero">
      <div class="wrap">
        <div class="portal-badge">
          <span class="pulse-dot"></span>
          ADVANTIA AI SUITE · ACCESO A APLICATIVOS
        </div>
        <h1 class="portal-title">Portal de Herramientas & Microservicios IA</h1>
        <p class="portal-subtitle">
          Explora y ejecuta nuestras soluciones independientes diseñadas para optimizar el contenido visual,
          los títulos SEO de catálogo y la sincronización multicanal para tu e-commerce.
        </p>

        <!-- Category Filters -->
        <div class="filter-tabs" id="filterTabs">
          <button class="tab-btn active" data-filter="all">Todos los Módulos (5)</button>
          <button class="tab-btn" data-filter="market-research">📊 Estudios de Mercado</button>
          <button class="tab-btn" data-filter="images">🎨 Imágenes & Visuales</button>
          <button class="tab-btn" data-filter="catalog">📝 Catálogo & SEO</button>
          <button class="tab-btn" data-filter="marketplaces">🛒 Marketplaces Sync</button>
        </div>

      </div>
    </section>

    <!-- Apps Hub Grid -->
    <section class="portal-grid-section">
      <div class="wrap">
        <div class="apps-grid" id="appsGrid">
          {modules.map((mod) => (
            <article class="app-card" data-category={mod.category} id={`card-${mod.id}`}>
              <a href={mod.href} class="card-link" aria-label={`Abrir módulo ${mod.name}`}>
                
                <!-- Card Header -->
                <div class="card-header">
                  <div class={`app-icon ${mod.glowClass}`}>
                    <span class="icon-emoji">{mod.icon}</span>
                  </div>
                  <div class="card-titles">
                    <span class="app-tag">{mod.tag}</span>
                    <h2 class="card-h2">{mod.name}</h2>
                  </div>
                  <span class="status-pill active">{mod.status}</span>
                </div>

                <!-- Description -->
                <p class="card-desc">
                  {mod.desc}
                </p>

                <!-- Badges / Tech specs -->
                <div class="card-chips">
                  {mod.badges.map((b) => (
                    <span class="chip-tag">{b}</span>
                  ))}
                </div>

                <!-- Action Footer -->
                <div class="card-footer">
                  <div class="action-button">
                    <span>{mod.ctaText}</span>
                    <span class="action-arrow">→</span>
                  </div>
                </div>

              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

  </main>
</Base>

<style>
  /* Base Portal Styles */
  .portal-main {
    background: #0B1F3A;
    color: #ffffff;
    min-height: 100vh;
    padding-bottom: 90px;
    font-family: var(--font-body, system-ui, -apple-system, sans-serif);
  }

  /* SESSION BAR */
  .session-bar {
    background: rgba(0, 0, 0, 0.4);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding: 12px 0;
  }

  .session-in {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .session-info {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .user-badge {
    font-size: 13px;
    color: #d4d4d4;
  }

  .user-badge strong {
    color: #B08D57;
  }

  .modules-count-pill {
    font-size: 12px;
    font-weight: 600;
    color: #B08D57;
    background: rgba(176, 141, 87, 0.12);
    border: 1px solid rgba(176, 141, 87, 0.3);
    padding: 4px 12px;
    border-radius: 9999px;
  }

  .status-pill {
    font-size: 11px;
    font-weight: 600;
    padding: 3px 10px;
    border-radius: 9999px;
    background: rgba(27, 175, 122, 0.15);
    color: #1BAF7A;
    border: 1px solid rgba(27, 175, 122, 0.3);
    white-space: nowrap;
  }

  /* PORTAL HERO */
  .portal-hero {
    background: radial-gradient(circle at 50% 0%, #1E2761 0%, #0B1F3A 75%);
    padding: 56px 0 36px 0;
    text-align: center;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .portal-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(176, 141, 87, 0.15);
    color: #B08D57;
    border: 1px solid rgba(176, 141, 87, 0.3);
    padding: 6px 18px;
    border-radius: 9999px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.5px;
    margin-bottom: 18px;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    background: #1BAF7A;
    border-radius: 50%;
    box-shadow: 0 0 8px #1BAF7A;
  }

  .portal-title {
    font-family: var(--font-display, inherit);
    font-size: clamp(28px, 4vw, 40px);
    font-weight: 800;
    color: #ffffff;
    margin: 0 0 14px 0;
    letter-spacing: -0.5px;
  }

  .portal-subtitle {
    max-width: 720px;
    margin: 0 auto 32px auto;
    font-size: 16px;
    color: #cbd5e1;
    line-height: 1.6;
  }

  /* FILTER TABS */
  .filter-tabs {
    display: flex;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .tab-btn {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #d4d4d4;
    padding: 9px 20px;
    border-radius: 9999px;
    font-size: 13.5px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .tab-btn:hover {
    background: rgba(255, 255, 255, 0.1);
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.25);
  }

  .tab-btn.active {
    background: #B08D57;
    color: #ffffff;
    border-color: #B08D57;
    box-shadow: 0 4px 14px rgba(176, 141, 87, 0.35);
  }

  /* APPS GRID */
  .portal-grid-section {
    padding-top: 44px;
  }

  .apps-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
    gap: 26px;
  }

  @media (max-width: 768px) {
    .apps-grid {
      grid-template-columns: 1fr;
    }
  }

  /* APP CARD */
  .app-card {
    background: rgba(30, 39, 97, 0.45);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 18px;
    backdrop-filter: blur(12px);
    transition: all 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
    position: relative;
    overflow: hidden;
    display: flex;
  }

  .app-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at top left, rgba(255, 255, 255, 0.05) 0%, transparent 70%);
    pointer-events: none;
  }

  .app-card:hover {
    transform: translateY(-5px);
    border-color: rgba(176, 141, 87, 0.6);
    background: rgba(30, 39, 97, 0.7);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.4), 0 0 24px rgba(176, 141, 87, 0.2);
  }

  .card-link {
    display: flex;
    flex-direction: column;
    padding: 26px;
    text-decoration: none;
    color: inherit;
    width: 100%;
    box-sizing: border-box;
    z-index: 1;
  }

  /* CARD HEADER */
  .card-header {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    margin-bottom: 14px;
  }

  .app-icon {
    width: 50px;
    height: 50px;
    min-width: 50px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    transition: transform 0.25s ease;
  }

  .app-card:hover .app-icon {
    transform: scale(1.1);
  }

  .gold-glow {
    background: rgba(176, 141, 87, 0.18);
    border: 1px solid rgba(176, 141, 87, 0.4);
    box-shadow: 0 0 18px rgba(176, 141, 87, 0.25);
  }

  .green-glow {
    background: rgba(27, 175, 122, 0.18);
    border: 1px solid rgba(27, 175, 122, 0.4);
    box-shadow: 0 0 18px rgba(27, 175, 122, 0.25);
  }

  .blue-glow {
    background: rgba(59, 130, 246, 0.18);
    border: 1px solid rgba(59, 130, 246, 0.4);
    box-shadow: 0 0 18px rgba(59, 130, 246, 0.25);
  }

  .purple-glow {
    background: rgba(138, 43, 226, 0.18);
    border: 1px solid rgba(138, 43, 226, 0.4);
    box-shadow: 0 0 18px rgba(138, 43, 226, 0.25);
  }

  .amber-glow {
    background: rgba(245, 158, 11, 0.18);
    border: 1px solid rgba(245, 158, 11, 0.4);
    box-shadow: 0 0 18px rgba(245, 158, 11, 0.25);
  }

  .card-titles {
    flex-grow: 1;
  }

  .app-tag {
    font-size: 10.5px;
    font-weight: 700;
    color: #B08D57;
    letter-spacing: 0.5px;
    display: block;
    margin-bottom: 4px;
    text-transform: uppercase;
  }

  .card-h2 {
    font-family: var(--font-display, inherit);
    font-size: 18px;
    font-weight: 700;
    color: #ffffff;
    margin: 0;
    line-height: 1.3;
    transition: color 0.2s ease;
  }

  .app-card:hover .card-h2 {
    color: #ffffff;
  }

  /* CARD DESC */
  .card-desc {
    color: #cbd5e1;
    font-size: 13.5px;
    line-height: 1.55;
    margin: 0 0 18px 0;
    flex-grow: 1;
  }

  /* CHIPS */
  .card-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 20px;
  }

  .chip-tag {
    font-size: 11px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #d4d4d4;
    padding: 3px 8px;
    border-radius: 6px;
    font-weight: 500;
  }

  /* CARD FOOTER */
  .card-footer {
    padding-top: 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .action-button {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #ffffff;
    font-size: 13px;
    font-weight: 700;
    padding: 10px 16px;
    border-radius: 8px;
    box-sizing: border-box;
    transition: all 0.2s ease;
  }

  .action-arrow {
    font-size: 16px;
    transition: transform 0.2s ease;
  }

  .app-card:hover .action-button {
    background: linear-gradient(135deg, #1E2761 0%, #B08D57 100%);
    border-color: #B08D57;
    box-shadow: 0 4px 14px rgba(176, 141, 87, 0.3);
  }

  .app-card:hover .action-arrow {
    transform: translateX(4px);
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // Interactive Category Filter Tabs
    const tabs = document.querySelectorAll('#filterTabs .tab-btn');
    const cards = document.querySelectorAll('#appsGrid .app-card');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        const filter = tab.getAttribute('data-filter');
        
        cards.forEach(card => {
          if (filter === 'all' || card.getAttribute('data-category') === filter) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  });
</script>
