    const mrClusterSelect = document.getElementById('mrClusterSelect');
    const mrSearchInput = document.getElementById('mrSearchInput');
    const btnResetMR = document.getElementById('btnResetMR');
    const mrTableBody = document.getElementById('mrTableBody');
    const mrKpiVolume = document.getElementById('mrKpiVolume');
    const mrKpiCount = document.getElementById('mrKpiCount');
    const mrKpiGrowth = document.getElementById('mrKpiGrowth');

    const renderMRTable = () => {
      if (!mrTableBody) return;
      
      const catVal = mrCategorySelect ? mrCategorySelect.value : 'ollas';
      const clusterVal = mrClusterSelect ? mrClusterSelect.value : 'all';
      const searchVal = mrSearchInput ? mrSearchInput.value.toLowerCase().trim() : '';

      const filtered = KEYWORD_DATASET.filter(item => {
        const matchCat = (catVal === 'ollas' && item.cat === 'ollas') || (item.cat === catVal);
        
        let matchCluster = true;
        if (clusterVal !== 'all') {
          if (clusterVal === 'quickwins') {
            matchCluster = item.intent === 'quickwin' || item.yoy.includes('+5') || item.yoy.includes('+2') || item.yoy.includes('+4');
          } else {
            matchCluster = item.cluster === clusterVal;
          }
        }

        const matchSearch = !searchVal || item.kw.toLowerCase().includes(searchVal);

        return matchCat && matchCluster && matchSearch;
      });

      // Render KPIs
      const totalVol = filtered.reduce((acc, curr) => acc + curr.vol, 0);
      if (mrKpiVolume) mrKpiVolume.innerText = `${totalVol.toLocaleString('es-CO')}/mes`;
      if (mrKpiCount) mrKpiCount.innerText = `${filtered.length} Términos`;

      if (filtered.length === 0) {
        mrTableBody.innerHTML = `
          <tr>
            <td colspan="6" style="text-align: center; padding: 24px; color: #a3a3a3;">
              🔍 No se encontraron términos con los filtros aplicados. Intenta cambiar el filtro o limpiar el buscador.
            </td>
          </tr>
        `;
        return;
      }

      mrTableBody.innerHTML = filtered.map(item => {
        let badgeClass = 'general';
        let badgeText = '⭐ General';
        if (item.intent === 'especifico') { badgeClass = 'especifico'; badgeText = '🎯 Específico'; }
        else if (item.intent === 'informacional') { badgeClass = 'informacional'; badgeText = '💡 FAQ / IA'; }
        else if (item.intent === 'quickwin') { badgeClass = 'especifico'; badgeText = '🚀 Quick Win'; }

        return `
          <tr>
            <td><strong>${item.kw}</strong></td>
            <td><strong>${item.vol.toLocaleString('es-CO')}</strong></td>
            <td style="color: ${item.yoy.startsWith('+') ? '#1BAF7A' : '#ef4444'}; font-weight: 700;">${item.yoy}</td>
            <td><span class="keyword-tag">${item.comp}</span></td>
            <td><span class="intent-badge ${badgeClass}">${badgeText}</span></td>
            <td><span class="mapping-chip">${item.mapping}</span></td>
          </tr>
        `;
      }).join('');
    };

    // Attach MR Event Listeners
    if (mrCategorySelect) mrCategorySelect.addEventListener('change', renderMRTable);
    if (mrClusterSelect) mrClusterSelect.addEventListener('change', renderMRTable);
    if (mrSearchInput) mrSearchInput.addEventListener('input', renderMRTable);
    
    if (btnResetMR) {
      btnResetMR.addEventListener('click', () => {
        if (mrCategorySelect) mrCategorySelect.value = 'ollas';
        if (mrClusterSelect) mrClusterSelect.value = 'all';
        if (mrSearchInput) mrSearchInput.value = '';
        renderMRTable();
      });
    }

    const btnExportCSV = document.getElementById('btnExportCSV');
