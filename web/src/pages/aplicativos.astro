---
import Base from '../layouts/Base.astro';

const seo = {
  title: 'Portal de Aplicativos & Herramientas IA | ADVANTIA',
  description: 'Acceso directo a la suite de aplicativos y microservicios de IA de Advantia: Estudios de Mercado, Flux AI, Remoción de Fondo WebGPU, CatalogAI y Marketplaces Sync.',
  canonical: 'https://theadvantia.com/aplicativos',
  robots: 'noindex, nofollow',
};

const modules = [
  {
    id: 'estudios-de-mercado',
    name: 'Estudios de Mercado & Demanda SEO',
    category: 'market-research',
    tag: 'CATALOG-AI MARKET INTELLIGENCE',
    icon: '📊',
    iconBg: '#FFFBEB',
    iconBorder: '#FDE68A',
    status: 'Dataset 2026 Activo',
    desc: 'Explora y desagrega la demanda real de búsqueda de compradores en Colombia por marcas, materiales, capacidades y dudas de salud para optimizar con CatalogAI.',
    href: '/estudios-de-mercado',
    badges: ['Google Keyword Planner', 'Clusters Semánticos', 'Quick Wins 4 Ejes'],
    actionText: 'Explorar Estudios'
  },
  {
    id: 'crear-imagenes',
    name: 'Crear Imágenes de Producto (Flux AI)',
    category: 'images',
    tag: 'FLUX / ATENEA AI WORKER',
    icon: '🎨',
    iconBg: '#FEF3C7',
    iconBorder: '#FCD34D',
    status: 'Engine Flash Activo',
    desc: 'Genera ambientaciones fotorrealistas en 4K y fondos comerciales conservando el 100% de la identidad de tu SKU con Gemini Flash Image y Atenea Studio.',
    href: '/crear-imagenes',
    badges: ['4K Fotorrealista', 'Gemini Flash Image', 'Falabella / MeLi Standard'],
    actionText: 'Generar Imágenes'
  },
  {
    id: 'quitar-fondo',
    name: 'Quitar Fondo Masivo (Zero-Server)',
    category: 'images',
    tag: 'LOCAL AI · WEBGPU / WASM',
    icon: '✂️',
    iconBg: '#ECFDF5',
    iconBorder: '#A7F3D0',
    status: '100% Local Browser',
    desc: 'Segmentación neuronal ultrarrápida ejecutada directamente en tu navegador sin subir imágenes a servidores. Salida a Fondo Blanco (#FFFFFF) o PNG Transparente.',
    href: '/quitar-fondo',
    badges: ['ONNX WebGPU', 'Privacidad Total', 'Fondo Blanco #FFFFFF'],
    actionText: 'Procesar Imágenes'
  },
  {
    id: 'descripcion-producto',
    name: 'Descripción de Producto & Títulos SEO',
    category: 'catalog',
    tag: 'CATALOG-AI PROTOCOL',
    icon: '📝',
    iconBg: '#EFF6FF',
    iconBorder: '#BFDBFE',
    status: 'Protocolo v4.2',
    desc: 'Generador inteligente de títulos estructurados a 60 caracteres, viñetas persuasivas de alto impacto y atributos técnicos para el SEO de Mercado Libre y Falabella.',
    href: '/descripcion-producto',
    badges: ['SEO 60 Caracteres', 'Bullet Points Persuasivos', 'Inyección Atributos'],
    actionText: 'Generar Ficha SEO'
  },
  {
    id: 'marketplaces-sync',
    name: 'Marketplaces Sync & Channel Connector',
    category: 'marketplaces',
    tag: 'VITRINA HUB CONNECTOR',
    icon: '🛒',
    iconBg: '#F5F3FF',
    iconBorder: '#DDD6FE',
    status: 'APIs Multicanal',
    desc: 'Conexión y auditoría en tiempo real con las APIs de Mercado Libre, Falabella Seller Center, Amazon SP-API y Homecenter para publicar atributos y auditar salud.',
    href: '/marketplaces-sync',
    badges: ['Mercado Libre API', 'Falabella Seller', 'Auditor de Salud SEO'],
    actionText: 'Conectar Canales'
  }
];
---

<Base seo={seo} active="/aplicativos">
  <main class="portal-page">

    <!-- Top Session Bar -->
    <div class="session-strip">
      <div class="wrap session-inner">
        <div class="session-left">
          <span class="user-chip">👤 Acceso de equipo</span>
          <span class="status-chip">🟢 Sesión Activa</span>
        </div>
        <div class="session-right">
          <span class="tag-counter">5 Módulos Disponibles</span>
        </div>
      </div>
    </div>

    <!-- Hero Header -->
    <section class="portal-hero">
      <div class="wrap">
        <div class="hero-center">
          <span class="eyebrow">ADVANTIA AI SUITE · PORTAL DE APLICATIVOS</span>
          <h1 class="hero-title">Módulos & Herramientas IA</h1>
          <p class="hero-desc">
            Selecciona un aplicativo para abrir su espacio de trabajo y ejecutar optimizaciones de catálogo, generación visual o sincronización de canales.
          </p>

          <!-- Category Filter Tabs -->
          <div class="filter-tabs" id="filterTabs">
            <button class="tab-btn active" data-filter="all">Todos los Módulos (5)</button>
            <button class="tab-btn" data-filter="market-research">📊 Estudios de Mercado</button>
            <button class="tab-btn" data-filter="images">🎨 Imágenes & Visuales</button>
            <button class="tab-btn" data-filter="catalog">📝 Catálogo & SEO</button>
            <button class="tab-btn" data-filter="marketplaces">🛒 Marketplaces Sync</button>
          </div>
        </div>
      </div>
    </section>

    <!-- Apps Hub Grid -->
    <section class="portal-grid-section">
      <div class="wrap">
        <div class="apps-grid" id="appsGrid">
          {modules.map((mod) => (
            <article class="app-card" data-category={mod.category} id={`card-${mod.id}`}>
              <a href={mod.href} class="app-card-anchor">
                
                <div class="card-head">
                  <div class="app-icon-box" style={`background: ${mod.iconBg}; border-color: ${mod.iconBorder};`}>
                    <span class="app-emoji">{mod.icon}</span>
                  </div>
                  <div class="card-status">
                    <span class="live-dot"></span>
                    <span>{mod.status}</span>
                  </div>
                </div>

                <div class="card-body">
                  <span class="app-tag">{mod.tag}</span>
                  <h2 class="app-title">{mod.name}</h2>
                  <p class="app-desc">{mod.desc}</p>
                </div>

                <div class="card-badges">
                  {mod.badges.map((b) => (
                    <span class="badge-chip">{b}</span>
                  ))}
                </div>

                <div class="card-footer">
                  <div class="action-btn">
                    <span>{mod.actionText}</span>
                    <span class="arrow-ico">→</span>
                  </div>
                </div>

              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

  </main>
</Base>

<style>
  /* ==========================================================================
     ADVANTIA · PORTAL DE APLICATIVOS (LIGHT THEME AMIGABLE Y LIMPIO)
     ========================================================================== */

  .portal-page {
    background: var(--surface-canvas, #ffffff);
    color: var(--ink, #1E2761);
    min-height: 85vh;
    padding-bottom: 80px;
    font-family: var(--font-body, system-ui, -apple-system, sans-serif);
  }

  /* 1. SESSION STRIP */
  .session-strip {
    background: var(--surface-card, #f8f9fa);
    border-bottom: 1px solid var(--bone, #e8e8e8);
    padding: 10px 0;
  }

  .session-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .session-left {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .user-chip {
    font-size: 13px;
    font-weight: 500;
    color: var(--body-ink, #3D4457);
  }

  .status-chip {
    font-size: 12px;
    font-weight: 600;
    color: var(--green, #1BAF7A);
    background: rgba(27, 175, 122, 0.1);
    border: 1px solid rgba(27, 175, 122, 0.25);
    padding: 2px 10px;
    border-radius: 9999px;
  }

  .tag-counter {
    font-size: 12px;
    font-weight: 600;
    color: var(--gold, #B08D57);
  }

  /* 2. HERO HEADER */
  .portal-hero {
    padding: 48px 0 32px;
    background: var(--surface-canvas, #ffffff);
    border-bottom: 1px solid var(--bone, #e8e8e8);
  }

  .hero-center {
    max-width: 860px;
    margin: 0 auto;
    text-align: center;
  }

  .eyebrow {
    display: inline-block;
    font-size: 12px;
    font-weight: 700;
    color: var(--gold, #B08D57);
    letter-spacing: 0.8px;
    text-transform: uppercase;
    margin-bottom: 12px;
  }

  .hero-title {
    font-family: var(--font-display, inherit);
    font-size: clamp(32px, 4vw, 44px);
    font-weight: 800;
    color: var(--ink, #1E2761);
    line-height: 1.2;
    margin: 0 0 16px 0;
    letter-spacing: -0.02em;
  }

  .hero-desc {
    font-size: 17px;
    color: var(--body-ink, #3D4457);
    line-height: 1.6;
    max-width: 680px;
    margin: 0 auto 32px auto;
  }

  /* 3. FILTER TABS */
  .filter-tabs {
    display: flex;
    justify-content: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .tab-btn {
    background: var(--surface-card, #f8f9fa);
    border: 1px solid var(--bone, #e8e8e8);
    color: var(--body-ink, #3D4457);
    padding: 8px 18px;
    border-radius: 9999px;
    font-size: 13.5px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .tab-btn:hover {
    border-color: var(--gold, #B08D57);
    color: var(--ink, #1E2761);
    background: #ffffff;
  }

  .tab-btn.active {
    background: var(--ink, #1E2761);
    color: #ffffff;
    border-color: var(--ink, #1E2761);
    box-shadow: 0 4px 12px rgba(30, 39, 97, 0.2);
  }

  /* 4. GRID & CARDS */
  .portal-grid-section {
    padding-top: 40px;
    background: var(--surface-card, #f8f9fa);
    min-height: 500px;
  }

  .apps-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 24px;
  }

  @media (max-width: 640px) {
    .apps-grid {
      grid-template-columns: 1fr;
    }
  }

  .app-card {
    display: flex;
  }

  .app-card-anchor {
    display: flex;
    flex-direction: column;
    width: 100%;
    background: #ffffff;
    border: 1px solid var(--bone, #e8e8e8);
    border-radius: var(--radius-cards, 14px);
    padding: 24px;
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  }

  .app-card-anchor:hover {
    transform: translateY(-4px);
    border-color: var(--gold, #B08D57);
    box-shadow: 0 12px 28px rgba(30, 39, 97, 0.1);
  }

  /* CARD HEAD */
  .card-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
  }

  .app-icon-box {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid transparent;
  }

  .app-emoji {
    font-size: 24px;
    line-height: 1;
  }

  .card-status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11.5px;
    font-weight: 600;
    color: var(--slate, #646464);
    background: var(--surface-card, #f8f9fa);
    border: 1px solid var(--bone, #e8e8e8);
    padding: 3px 9px;
    border-radius: 9999px;
  }

  .live-dot {
    width: 6px;
    height: 6px;
    background: var(--green, #1BAF7A);
    border-radius: 50%;
  }

  /* CARD BODY */
  .card-body {
    flex-grow: 1;
    margin-bottom: 16px;
  }

  .app-tag {
    font-size: 10.5px;
    font-weight: 700;
    color: var(--gold, #B08D57);
    letter-spacing: 0.6px;
    text-transform: uppercase;
    display: block;
    margin-bottom: 6px;
  }

  .app-title {
    font-family: var(--font-display, inherit);
    font-size: 19px;
    font-weight: 700;
    color: var(--ink, #1E2761);
    margin: 0 0 8px 0;
    line-height: 1.3;
  }

  .app-card-anchor:hover .app-title {
    color: var(--gold, #B08D57);
  }

  .app-desc {
    font-size: 14px;
    color: var(--body-ink, #3D4457);
    line-height: 1.5;
    margin: 0;
  }

  /* BADGES */
  .card-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 18px;
  }

  .badge-chip {
    font-size: 11px;
    background: var(--surface-card, #f8f9fa);
    border: 1px solid var(--bone, #e8e8e8);
    color: var(--slate, #646464);
    padding: 3px 8px;
    border-radius: 6px;
    font-weight: 500;
  }

  /* FOOTER & BUTTON */
  .card-footer {
    padding-top: 14px;
    border-top: 1px solid var(--bone, #e8e8e8);
  }

  .action-btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    background: var(--surface-card, #f8f9fa);
    border: 1px solid var(--bone, #e8e8e8);
    color: var(--ink, #1E2761);
    font-size: 13px;
    font-weight: 700;
    padding: 9px 14px;
    border-radius: 8px;
    transition: all 0.2s ease;
  }

  .arrow-ico {
    font-size: 15px;
    transition: transform 0.2s ease;
  }

  .app-card-anchor:hover .action-btn {
    background: var(--ink, #1E2761);
    color: #ffffff;
    border-color: var(--ink, #1E2761);
  }

  .app-card-anchor:hover .arrow-ico {
    transform: translateX(4px);
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // Interactive Category Filter Tabs
    const tabs = document.querySelectorAll('#filterTabs .tab-btn');
    const cards = document.querySelectorAll('#appsGrid .app-card');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        const filter = tab.getAttribute('data-filter');
        
        cards.forEach(card => {
          if (filter === 'all' || card.getAttribute('data-category') === filter) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  });
</script>
