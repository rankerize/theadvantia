<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Filter Tabs Interactivity
    const tabs = document.querySelectorAll('#filterTabs .tab-btn');
    const cards = document.querySelectorAll('#appsGrid .app-card');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => t.classList.remove('active'));
        tab.classList.add('active');

        const filter = tab.getAttribute('data-filter');
        cards.forEach(card => {
          if (filter === 'all' || card.getAttribute('data-category') === filter) {
            card.style.display = 'block';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });

    // 2. Flux Image Gen Simulation
    const btnFlux = document.getElementById('btnGenFlux');
    const fluxPlaceholder = document.getElementById('fluxPlaceholder');
    const fluxResult = document.getElementById('fluxResult');
    const fluxPrompt = document.getElementById('fluxPrompt');

    if (btnFlux) {
      btnFlux.addEventListener('click', () => {
        btnFlux.disabled = true;
        btnFlux.innerText = '⚡ Procesando con Flux AI Worker...';
        
        setTimeout(() => {
          fluxPlaceholder.classList.add('hidden');
          fluxResult.classList.remove('hidden');
          btnFlux.disabled = false;
          btnFlux.innerText = '⚡ Generar Ambientación IA';
        }, 1200);
      });
    }

    // 3. BG Removal Simulation
    const btnBg = document.getElementById('btnProcessBg');
    const bgPlaceholder = document.getElementById('bgPlaceholder');
    const bgResult = document.getElementById('bgResult');
    const dropzoneBg = document.getElementById('dropzoneBg');
    const fileInputBg = document.getElementById('fileInputBg');
    const paddingRange = document.getElementById('paddingRange');
    const paddingVal = document.getElementById('paddingVal');
    const canvasBgPreview = document.getElementById('canvasBgPreview');
    const bgModeBtns = document.querySelectorAll('#bgModeControl .seg-btn');

    if (dropzoneBg && fileInputBg) {
      dropzoneBg.addEventListener('click', () => fileInputBg.click());
    }

    if (paddingRange && paddingVal) {
      paddingRange.addEventListener('input', (e) => {
        paddingVal.innerText = `${e.target.value}%`;
      });
    }

    if (bgModeBtns) {
      bgModeBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          bgModeBtns.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          const mode = btn.getAttribute('data-mode');
          if (canvasBgPreview) {
            canvasBgPreview.style.background = mode === 'white' ? '#ffffff' : 'repeating-conic-gradient(#e9ebf0 0% 25%, #ffffff 0% 50%) 50% / 16px 16px';
          }
        });
      });
    }

    if (btnBg) {
      btnBg.addEventListener('click', () => {
        btnBg.disabled = true;
        btnBg.innerText = '✂️ Procesando WebGPU ONNX local...';
        
        setTimeout(() => {
          if (bgPlaceholder) bgPlaceholder.classList.add('hidden');
          if (bgResult) bgResult.classList.remove('hidden');
          btnBg.disabled = false;
          btnBg.innerText = '✂️ Procesar Remoción de Fondo';
        }, 800);
      });
    }

    // 4. CatalogAI Desc Simulation
    const btnDesc = document.getElementById('btnOptimizeDesc');
    const descPlaceholder = document.getElementById('descPlaceholder');
    const descResult = document.getElementById('descResult');
    const prodTitleInput = document.getElementById('prodTitleInput');
    const outTitle = document.getElementById('outTitle');

    if (btnDesc) {
      btnDesc.addEventListener('click', () => {
        btnDesc.disabled = true;
        btnDesc.innerText = '🚀 Aplicando Protocolo CatalogAI...';

        setTimeout(() => {
          if (descPlaceholder) descPlaceholder.classList.add('hidden');
          if (descResult) descResult.classList.remove('hidden');
          if (outTitle && prodTitleInput) {
            outTitle.innerText = `${prodTitleInput.value} Transpirables Suela Antideslizante (SEO Max)`;
          }
          btnDesc.disabled = false;
          btnDesc.innerText = '🚀 Generar Título & Descripción CatalogAI';
        }, 1000);
      });
    }

    // 5. Marketplaces Check
    const btnCheckListing = document.getElementById('btnCheckListing');
    if (btnCheckListing) {
      btnCheckListing.addEventListener('click', () => {
        alert('Auditando publicación MCO-984210492 en tiempo real vía marketplaces-service... ¡Salud 96% OK!');
      });
    }
  });
</script>
