---
import Base from '../layouts/Base.astro';

const seo = {
  title: 'Portal de Aplicativos & Herramientas IA | ADVANTIA',
  description: 'Acceso directo a la suite de aplicativos y microservicios de IA de Advantia: Estudios de Mercado, Flux AI, Remoción de Fondo WebGPU, CatalogAI y Marketplaces Sync.',
  canonical: 'https://theadvantia.com/aplicativos',
  robots: 'noindex, nofollow',
};

const modules = [
  {
    id: 'estudios-de-mercado',
    name: 'Estudios de Mercado & Demanda SEO',
    category: 'market-research',
    tag: 'CATALOG-AI MARKET INTELLIGENCE',
    icon: '📊',
    glowClass: 'amber-glow',
    accentColor: '#F59E0B',
    status: 'Dataset 2026 Activo',
    statusType: 'online',
    desc: 'Explora y desagrega la demanda real de búsqueda de compradores en Colombia por marcas, materiales, capacidades y dudas de salud para optimizar con CatalogAI.',
    href: '/estudios-de-mercado',
    badges: ['Google Keyword Planner', 'Clusters Semánticos', 'Quick Wins 4 Ejes'],
    actionText: 'Explorar Estudios'
  },
  {
    id: 'crear-imagenes',
    name: 'Crear Imágenes de Producto (Flux AI)',
    category: 'images',
    tag: 'FLUX / ATENEA AI WORKER',
    icon: '🎨',
    glowClass: 'gold-glow',
    accentColor: '#B08D57',
    status: 'Engine Flash Activo',
    statusType: 'online',
    desc: 'Genera ambientaciones fotorrealistas en 4K y fondos comerciales conservando el 100% de la identidad de tu SKU con Gemini Flash Image y Atenea Studio.',
    href: '/crear-imagenes',
    badges: ['4K Fotorrealista', 'Gemini Flash Image', 'Falabella / MeLi Standard'],
    actionText: 'Generar Imágenes'
  },
  {
    id: 'quitar-fondo',
    name: 'Quitar Fondo Masivo (Zero-Server)',
    category: 'images',
    tag: 'LOCAL AI · WEBGPU / WASM',
    icon: '✂️',
    glowClass: 'green-glow',
    accentColor: '#10B981',
    status: '100% Local Browser',
    statusType: 'online',
    desc: 'Segmentación neuronal ultrarrápida ejecutada directamente en tu navegador sin subir imágenes a servidores. Salida a Fondo Blanco (#FFFFFF) o PNG Transparente.',
    href: '/quitar-fondo',
    badges: ['ONNX WebGPU', 'Privacidad Total', 'Fondo Blanco #FFFFFF'],
    actionText: 'Procesar Imágenes'
  },
  {
    id: 'descripcion-producto',
    name: 'Descripción de Producto & Títulos SEO',
    category: 'catalog',
    tag: 'CATALOG-AI PROTOCOL',
    icon: '📝',
    glowClass: 'blue-glow',
    accentColor: '#3B82F6',
    status: 'Protocolo v4.2',
    statusType: 'online',
    desc: 'Generador inteligente de títulos estructurados a 60 caracteres, viñetas persuasivas de alto impacto y atributos técnicos para el SEO de Mercado Libre y Falabella.',
    href: '/descripcion-producto',
    badges: ['SEO 60 Caracteres', 'Bullet Points Persuasivos', 'Inyección Atributos'],
    actionText: 'Generar Ficha SEO'
  },
  {
    id: 'marketplaces-sync',
    name: 'Marketplaces Sync & Channel Connector',
    category: 'marketplaces',
    tag: 'VITRINA HUB CONNECTOR',
    icon: '🛒',
    glowClass: 'purple-glow',
    accentColor: '#8B5CF6',
    status: 'APIs Multicanal',
    statusType: 'online',
    desc: 'Conexión y auditoría en tiempo real con las APIs de Mercado Libre, Falabella Seller Center, Amazon SP-API y Homecenter para publicar atributos y auditar salud.',
    href: '/marketplaces-sync',
    badges: ['Mercado Libre API', 'Falabella Seller', 'Auditor de Salud SEO'],
    actionText: 'Conectar Canales'
  }
];
---

<Base seo={seo} active="/aplicativos">
  <main class="portal-wrapper">

    <!-- Top Live Status Bar -->
    <header class="status-ribbon">
      <div class="wrap ribbon-content">
        <div class="ribbon-left">
          <span class="pulse-indicator"></span>
          <span class="ribbon-title">ADVANTIA AI SUITE · ESPACIO DE TRABAJO</span>
          <span class="ribbon-sep">/</span>
          <span class="user-chip">👤 Sesión Activa</span>
        </div>
        <div class="ribbon-right">
          <span class="stat-pill"><strong class="pill-val">5</strong> Módulos Disponibles</span>
          <span class="stat-pill"><strong class="pill-val">4</strong> Microservicios (:3001-:3004)</span>
        </div>
      </div>
    </header>

    <!-- Hero Header -->
    <section class="portal-header">
      <div class="wrap header-inner">
        <div class="badge-capsule">
          <span class="sparkle">✨</span>
          <span>SUITE DE HERRAMIENTAS Y APLICATIVOS B2B</span>
        </div>
        
        <h1 class="header-headline">
          Portal de <span class="gold-gradient-text">Aplicativos IA</span>
        </h1>
        
        <p class="header-desc">
          Accede a los módulos especializados de Vitrina y Trastienda para optimizar catálogos, procesar imágenes a escala y sincronizar canales de venta.
        </p>

        <!-- KPI Quick Metric Bar -->
        <div class="kpi-grid">
          <div class="kpi-item">
            <span class="kpi-number">5</span>
            <span class="kpi-label">Módulos Especializados</span>
          </div>
          <div class="kpi-item">
            <span class="kpi-number">4</span>
            <span class="kpi-label">Marketplaces Soportados</span>
          </div>
          <div class="kpi-item">
            <span class="kpi-number">100%</span>
            <span class="kpi-label">Privacidad & WebGPU</span>
          </div>
          <div class="kpi-item">
            <span class="kpi-number">v4.2</span>
            <span class="kpi-label">Protocolo CatalogAI</span>
          </div>
        </div>

        <!-- Category Filter Tabs -->
        <div class="filter-container">
          <span class="filter-label">Filtrar por categoría:</span>
          <div class="tabs-list" id="filterTabs">
            <button class="tab-chip active" data-filter="all">Todos los Módulos (5)</button>
            <button class="tab-chip" data-filter="market-research">📊 Estudios de Mercado</button>
            <button class="tab-chip" data-filter="images">🎨 Imágenes & Visuales</button>
            <button class="tab-chip" data-filter="catalog">📝 Catálogo & SEO</button>
            <button class="tab-chip" data-filter="marketplaces">🛒 Marketplaces Sync</button>
          </div>
        </div>

      </div>
    </section>

    <!-- Main Apps Grid -->
    <section class="portal-grid-wrap">
      <div class="wrap">
        <div class="cards-grid" id="appsGrid">
          {modules.map((mod) => (
            <article class="app-card-wrapper" data-category={mod.category} id={`card-${mod.id}`}>
              <a href={mod.href} class="app-card-link">
                
                <!-- Card Header -->
                <div class="card-head">
                  <div class={`icon-badge ${mod.glowClass}`}>
                    <span class="emoji-icon">{mod.icon}</span>
                  </div>
                  <div class="status-badge-live">
                    <span class="live-dot"></span>
                    <span class="status-text">{mod.status}</span>
                  </div>
                </div>

                <!-- Card Body -->
                <div class="card-body">
                  <span class="category-eyebrow">{mod.tag}</span>
                  <h2 class="card-heading">{mod.name}</h2>
                  <p class="card-summary">{mod.desc}</p>
                </div>

                <!-- Badges / Tags -->
                <div class="badges-row">
                  {mod.badges.map((badge) => (
                    <span class="tag-pill">{badge}</span>
                  ))}
                </div>

                <!-- Card Footer / CTA -->
                <div class="card-action-bar">
                  <span class="btn-action">
                    <span class="btn-action-text">{mod.actionText}</span>
                    <span class="btn-action-icon">→</span>
                  </span>
                </div>

              </a>
            </article>
          ))}
        </div>

        <!-- Microservices Health Monitor Strip -->
        <aside class="services-monitor-card">
          <div class="monitor-left">
            <div class="monitor-icon">⚡</div>
            <div class="monitor-text">
              <strong>Arquitectura de Microservicios Advantia</strong>
              <p>Conectores backend ejecutándose en Node.js, Hono & WebGPU para alta concurrencia e inferencia local.</p>
            </div>
          </div>
          <div class="monitor-chips">
            <div class="port-chip"><span class="dot-ok"></span> <code>:3001</code> Marketplaces</div>
            <div class="port-chip"><span class="dot-ok"></span> <code>:3002</code> Agentes WhatsApp</div>
            <div class="port-chip"><span class="dot-ok"></span> <code>:3003</code> Wompi Payments</div>
            <div class="port-chip"><span class="dot-ok"></span> <code>:3004</code> Market Research</div>
          </div>
        </aside>

      </div>
    </section>

  </main>
</Base>

<style is:global>
  /* ==========================================================================
     ADVANTIA APLICATIVOS PORTAL · HIGH-CONTRAST DARK THEME STYLES
     ========================================================================== */

  .portal-wrapper {
    background-color: #061121 !important;
    background-image: 
      radial-gradient(at 0% 0%, rgba(30, 39, 97, 0.6) 0px, transparent 50%),
      radial-gradient(at 100% 0%, rgba(176, 141, 87, 0.15) 0px, transparent 50%),
      radial-gradient(at 50% 100%, rgba(11, 31, 58, 0.8) 0px, transparent 50%) !important;
    color: #F8FAFC !important;
    min-height: 100vh;
    padding-bottom: 80px;
    font-family: var(--font-body, system-ui, -apple-system, sans-serif);
  }

  /* 1. TOP LIVE RIBBON */
  .status-ribbon {
    background: rgba(4, 11, 22, 0.75);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(12px);
    padding: 10px 0;
  }

  .ribbon-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
  }

  .ribbon-left {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .pulse-indicator {
    width: 8px;
    height: 8px;
    background: #10B981;
    border-radius: 50%;
    box-shadow: 0 0 10px #10B981;
    animation: portalPulse 2s infinite;
  }

  @keyframes portalPulse {
    0% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.6); }
    70% { box-shadow: 0 0 0 8px rgba(16, 185, 129, 0); }
    100% { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
  }

  .ribbon-title {
    font-size: 11.5px;
    font-weight: 700;
    color: #CBD5E1;
    letter-spacing: 0.8px;
  }

  .ribbon-sep {
    color: rgba(255, 255, 255, 0.2);
  }

  .user-chip {
    font-size: 12px;
    color: #94A3B8;
    background: rgba(255, 255, 255, 0.05);
    padding: 3px 10px;
    border-radius: 6px;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .ribbon-right {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .stat-pill {
    font-size: 12px;
    color: #94A3B8;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 3px 10px;
    border-radius: 9999px;
  }

  .pill-val {
    color: #F8FAFC;
    font-weight: 700;
  }

  /* 2. PORTAL HEADER */
  .portal-header {
    padding: 56px 0 36px 0;
    text-align: center;
  }

  .header-inner {
    max-width: 960px;
    margin: 0 auto;
  }

  .badge-capsule {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(176, 141, 87, 0.12);
    border: 1px solid rgba(176, 141, 87, 0.3);
    color: #E5C07B;
    padding: 6px 16px;
    border-radius: 9999px;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.6px;
    margin-bottom: 20px;
  }

  .header-headline {
    font-family: var(--font-display, inherit);
    font-size: 44px;
    font-weight: 800;
    color: #FFFFFF !important;
    line-height: 1.15;
    margin: 0 0 16px 0;
    letter-spacing: -0.02em;
  }

  .gold-gradient-text {
    background: linear-gradient(135deg, #FFF6E5 0%, #E5C07B 50%, #B08D57 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    display: inline-block;
  }

  .header-desc {
    font-size: 16.5px;
    color: #94A3B8 !important;
    line-height: 1.6;
    max-width: 720px;
    margin: 0 auto 36px auto;
  }

  /* 3. KPI METRIC GRID */
  .kpi-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin: 0 auto 36px auto;
    max-width: 820px;
  }

  @media (max-width: 768px) {
    .kpi-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .kpi-item {
    background: rgba(15, 23, 42, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 14px 12px;
    display: flex;
    flex-direction: column;
    align-items: center;
    backdrop-filter: blur(8px);
  }

  .kpi-number {
    font-size: 22px;
    font-weight: 800;
    color: #FFFFFF;
    line-height: 1;
    margin-bottom: 4px;
  }

  .kpi-label {
    font-size: 11px;
    color: #64748B;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.4px;
  }

  /* 4. FILTER TABS */
  .filter-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .filter-label {
    font-size: 12px;
    font-weight: 600;
    color: #64748B;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .tabs-list {
    display: flex;
    justify-content: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .tab-chip {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #94A3B8;
    padding: 8px 18px;
    border-radius: 9999px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .tab-chip:hover {
    background: rgba(255, 255, 255, 0.08);
    color: #FFFFFF;
    border-color: rgba(255, 255, 255, 0.2);
  }

  .tab-chip.active {
    background: #B08D57;
    color: #061121;
    font-weight: 700;
    border-color: #E5C07B;
    box-shadow: 0 4px 14px rgba(176, 141, 87, 0.4);
  }

  /* 5. CARDS GRID */
  .portal-grid-wrap {
    padding-top: 32px;
  }

  .cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 24px;
    margin-bottom: 40px;
  }

  @media (max-width: 640px) {
    .cards-grid {
      grid-template-columns: 1fr;
    }
  }

  /* 6. APP CARD COMPONENT */
  .app-card-wrapper {
    display: flex;
  }

  .app-card-link {
    display: flex;
    flex-direction: column;
    width: 100%;
    background: #0D1B33 !important;
    border: 1px solid rgba(255, 255, 255, 0.12) !important;
    border-radius: 18px !important;
    padding: 26px !important;
    text-decoration: none !important;
    color: inherit !important;
    position: relative;
    overflow: hidden;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
  }

  .app-card-link::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: transparent;
    transition: background 0.3s ease;
  }

  .app-card-link:hover {
    transform: translateY(-4px);
    background: #112242 !important;
    border-color: rgba(229, 192, 123, 0.45) !important;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5), 0 0 25px rgba(176, 141, 87, 0.15) !important;
  }

  .app-card-link:hover::before {
    background: linear-gradient(90deg, #B08D57, #E5C07B, #10B981);
  }

  /* CARD HEAD */
  .card-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 18px;
  }

  .icon-badge {
    width: 54px;
    height: 54px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    transition: transform 0.25s ease;
  }

  .app-card-link:hover .icon-badge {
    transform: scale(1.08);
  }

  .emoji-icon {
    font-size: 26px;
    line-height: 1;
  }

  /* ICON GLOWS */
  .amber-glow {
    background: rgba(245, 158, 11, 0.15);
    border-color: rgba(245, 158, 11, 0.35);
    box-shadow: 0 0 16px rgba(245, 158, 11, 0.2);
  }
  .gold-glow {
    background: rgba(176, 141, 87, 0.15);
    border-color: rgba(176, 141, 87, 0.35);
    box-shadow: 0 0 16px rgba(176, 141, 87, 0.2);
  }
  .green-glow {
    background: rgba(16, 185, 129, 0.15);
    border-color: rgba(16, 185, 129, 0.35);
    box-shadow: 0 0 16px rgba(16, 185, 129, 0.2);
  }
  .blue-glow {
    background: rgba(59, 130, 246, 0.15);
    border-color: rgba(59, 130, 246, 0.35);
    box-shadow: 0 0 16px rgba(59, 130, 246, 0.2);
  }
  .purple-glow {
    background: rgba(139, 92, 246, 0.15);
    border-color: rgba(139, 92, 246, 0.35);
    box-shadow: 0 0 16px rgba(139, 92, 246, 0.2);
  }

  .status-badge-live {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 9999px;
    background: rgba(15, 23, 42, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #CBD5E1;
  }

  .live-dot {
    width: 6px;
    height: 6px;
    background: #10B981;
    border-radius: 50%;
    box-shadow: 0 0 6px #10B981;
  }

  /* CARD BODY */
  .card-body {
    flex-grow: 1;
    margin-bottom: 18px;
  }

  .category-eyebrow {
    font-size: 11px;
    font-weight: 700;
    color: #E5C07B !important;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    display: block;
    margin-bottom: 6px;
  }

  .card-heading {
    font-family: var(--font-display, inherit);
    font-size: 20px !important;
    font-weight: 700 !important;
    color: #FFFFFF !important;
    margin: 0 0 10px 0 !important;
    line-height: 1.3 !important;
    transition: color 0.2s ease;
  }

  .app-card-link:hover .card-heading {
    color: #FFF6E5 !important;
  }

  .card-summary {
    font-size: 13.5px !important;
    color: #94A3B8 !important;
    line-height: 1.55 !important;
    margin: 0 !important;
  }

  /* BADGES ROW */
  .badges-row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 22px;
  }

  .tag-pill {
    font-size: 11px;
    background: rgba(15, 23, 42, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: #CBD5E1;
    padding: 3px 8px;
    border-radius: 6px;
  }

  /* ACTION BAR */
  .card-action-bar {
    padding-top: 14px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .btn-action {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #FFFFFF !important;
    font-size: 13px;
    font-weight: 700;
    padding: 10px 14px;
    border-radius: 9px;
    transition: all 0.2s ease;
  }

  .btn-action-icon {
    font-size: 15px;
    transition: transform 0.2s ease;
  }

  .app-card-link:hover .btn-action {
    background: #B08D57;
    color: #061121 !important;
    border-color: #E5C07B;
    box-shadow: 0 4px 12px rgba(176, 141, 87, 0.35);
  }

  .app-card-link:hover .btn-action-icon {
    transform: translateX(4px);
  }

  /* 7. SERVICES MONITOR CARD */
  .services-monitor-card {
    background: rgba(13, 27, 51, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 14px;
    padding: 18px 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
    backdrop-filter: blur(10px);
  }

  .monitor-left {
    display: flex;
    align-items: center;
    gap: 14px;
    max-width: 500px;
  }

  .monitor-icon {
    font-size: 24px;
    background: rgba(245, 158, 11, 0.15);
    width: 42px;
    height: 42px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #F59E0B;
    border: 1px solid rgba(245, 158, 11, 0.3);
  }

  .monitor-text strong {
    font-size: 13.5px;
    color: #FFFFFF;
    display: block;
    margin-bottom: 2px;
  }

  .monitor-text p {
    font-size: 12px;
    color: #94A3B8;
    margin: 0;
    line-height: 1.4;
  }

  .monitor-chips {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .port-chip {
    font-size: 11.5px;
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 4px 10px;
    border-radius: 6px;
    color: #CBD5E1;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .port-chip code {
    color: #E5C07B;
    font-weight: 700;
  }

  .dot-ok {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #10B981;
    box-shadow: 0 0 5px #10B981;
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // Interactive Category Filter Tabs
    const tabs = document.querySelectorAll('#filterTabs .tab-chip');
    const cards = document.querySelectorAll('#appsGrid .app-card-wrapper');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        const filter = tab.getAttribute('data-filter');
        
        cards.forEach(card => {
          if (filter === 'all' || card.getAttribute('data-category') === filter) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  });
</script>
