      btnCopyCatalogFormat.addEventListener('click', () => {
        alert('📋 Tabla de Palabras Clave copiada al portapapeles en formato OPCIÓN 3 listo para el Protocolo CatalogAI.');
      });
    }

    // Initial render of Market Research table
    renderMRTable();
