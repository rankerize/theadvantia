---
import Base from '../layouts/Base.astro';

const seo = {
  title: 'Acceso Restringido | Portal de Aplicativos ADVANTIA',
  description: 'Ingreso al portal de microservicios y herramientas de IA de Advantia para usuarios autorizados.',
  canonical: 'https://theadvantia.com/aplicativos',
  // Portal interno: protegido con usuario y clave en el servidor (.htaccess + .htpasswd)
  robots: 'noindex, nofollow',
};
---

<Base seo={seo} active="/aplicativos">
  <main class="portal-main">

    <!-- PORTAL SUITE CONTENT: el acceso lo controla el servidor con usuario y clave -->
    <div id="portalContent" class="portal-content">
      
      <!-- Top Session Bar -->
      <div class="session-bar">
        <div class="wrap session-in">
          <div class="session-info">
            <span class="user-badge">👤 Acceso de equipo</span>
            <span class="status-pill active">🟢 Sesión Activa</span>
          </div>
        </div>
      </div>

      <!-- Hero Header -->
      <section class="portal-hero">
        <div class="wrap">
          <div class="portal-badge">
            <span class="pulse-dot"></span>
            ADVANTIA AI SUITE · ACCESO A APLICATIVOS
          </div>
          <h1 class="portal-title">Portal de Herramientas & Microservicios IA</h1>
          <p class="portal-subtitle">
            Explora y ejecuta nuestras soluciones independientes diseñadas para optimizar el contenido visual,
            los títulos SEO de catálogo y la sincronización multicanal para tu e-commerce.
          </p>

          <!-- Category Filters -->
          <div class="filter-tabs" id="filterTabs">
            <button class="tab-btn active" data-filter="all">Todos los Módulos (5)</button>
            <button class="tab-btn" data-filter="market-research">📊 Estudios de Mercado</button>
            <button class="tab-btn" data-filter="images">🎨 Imágenes & Visuales</button>
            <button class="tab-btn" data-filter="catalog">📝 Catálogo & SEO</button>
            <button class="tab-btn" data-filter="marketplaces">🛒 Marketplaces Sync</button>
          </div>

        </div>
      </section>

      <!-- Apps Grid & Workspaces -->
      <section class="portal-grid-section">
        <div class="wrap">
          <div class="apps-grid" id="appsGrid">
            
            <!-- App 1: Crear Imagen Flux -->
            <article class="app-card" data-category="images" id="card-flux">
              <div class="card-header">
                <div class="app-icon gold-glow">🎨</div>
                <div class="card-titles">
                  <span class="app-tag">FLUX / ATENEA AI WORKER</span>
                  <h3>Crear Imágenes de Producto (Flux AI)</h3>
                </div>
                <span class="status-pill active">🟢 Servicio Activo</span>
              </div>
              <p class="card-desc">
                Genera ambientaciones fotorrealistas, cambios de escena y fondos publicitarios de alta definición para tus SKUs utilizando el modelo Flux y Falabella Atenea AI Studio.
              </p>

              <div class="workspace-box">
                <div class="ws-header">
                  <h4>Espacio de Trabajo: Ambientación de Producto</h4>
                  <span class="engine-badge">Engine: Gemini 3.1 Flash Image</span>
                </div>
                
                <div class="ws-body">
                  <div class="form-group">
                    <label for="fluxPrompt">Prompt de Ambientación</label>
                    <input type="text" id="fluxPrompt" value="Mesa de madera estilo nórdico con luz solar suave filtrada por plantas, 4k fotorrealista" class="app-input" />
                  </div>

                  <div class="form-row">
                    <div class="form-group half">
                      <label>Relación de Aspecto</label>
                      <select id="fluxAspect" class="app-select">
                        <option value="1:1">1:1 Cuadrado (Catálogo)</option>
                        <option value="4:5" selected>4:5 Móvil (Falabella/MeLi)</option>
                        <option value="16:9">16:9 Banner Publicitario</option>
                      </select>
                    </div>
                    <div class="form-group half">
                      <label>Presets Rápidos</label>
                      <select id="fluxPreset" class="app-select">
                        <option value="estudio">Mármol & Sombras Botánicas</option>
                        <option value="nordico" selected>Mesa de Madera & Luz Natural</option>
                        <option value="minimalista">Fondo Podio Neutro Minimalista</option>
                      </select>
                    </div>
                  </div>

                  <button class="app-btn btn-primary" id="btnGenFlux">
                    <span>⚡ Generar Ambientación IA</span>
                  </button>

                  <div class="preview-stage" id="fluxStage">
                    <div class="placeholder-content" id="fluxPlaceholder">
                      <span class="sparkle-icon">✨</span>
                      <p>Haz clic en "Generar Ambientación IA" para simular la renderización con el worker.</p>
                    </div>
                    <div class="result-box hidden" id="fluxResult">
                      <div class="img-frame">
                        <div class="simulated-image" id="simulatedImg">
                          <div class="prod-badge">PRODUCTO PRESERVADO</div>
                          <div class="scene-overlay">AMBIENTACIÓN FLUX AI</div>
                        </div>
                      </div>
                      <div class="result-meta">
                        <span class="tag-success">✓ 100% SKU Preservado</span>
                        <span class="tag-info">Res: 1200x1500 px</span>
                        <button class="app-btn btn-secondary sm" onclick="alert('Descargando imagen procesada...')">📥 Descargar HD</button>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </article>

            <!-- App 2: Quitar Fondo WebGPU -->
            <article class="app-card" data-category="images" id="card-bg">
              <div class="card-header">
                <div class="app-icon green-glow">✂️</div>
                <div class="card-titles">
                  <span class="app-tag">LOCAL AI · WEBGPU / WASM</span>
                  <h3>Quitar Fondo Masivo (Zero-Server)</h3>
                </div>
                <span class="status-pill active">🟢 100% Local Browser</span>
              </div>
              <p class="card-desc">
                Segmentación neuronal ultrarrápida que ejecuta modelos ONNX directamente en tu navegador. Elimina fondos sin enviar imágenes a ningún servidor externo.
              </p>

              <div class="workspace-box">
                <div class="ws-header">
                  <h4>Espacio de Trabajo: Remoción de Fondo</h4>
                  <span class="engine-badge">ONNX Runtime WebGPU</span>
                </div>

                <div class="ws-body">
                  <div class="dropzone" id="dropzoneBg">
                    <div class="dz-message">
                      <span class="dz-icon">📁</span>
                      <p>Arrastra aquí tus fotos de producto o <strong>haz clic para examinar</strong></p>
                      <span class="dz-hint">Admite JPG, PNG, WEBP · Procesamiento masivo disponible</span>
                    </div>
                    <input type="file" id="fileInputBg" accept="image/*" class="hidden-file" />
                  </div>

                  <div class="form-row margin-top">
                    <div class="form-group half">
                      <label>Fondo de Salida</label>
                      <div class="segmented-control" id="bgModeControl">
                        <button class="seg-btn active" data-mode="white">⚪ Blanco Puro (#FFF)</button>
                        <button class="seg-btn" data-mode="transparent">🏁 Transparente</button>
                      </div>
                    </div>
                    <div class="form-group half">
                      <label>Margen / Padding Perimetral: <span id="paddingVal">8%</span></label>
                      <input type="range" id="paddingRange" min="0" max="20" value="8" class="app-range" />
                    </div>
                  </div>

                  <button class="app-btn btn-primary" id="btnProcessBg">
                    <span>✂️ Procesar Remoción de Fondo</span>
                  </button>

                  <div class="preview-stage" id="bgStage">
                    <div class="placeholder-content" id="bgPlaceholder">
                      <p>Carga una imagen o procesa la de demostración para ver el lienzo Falabella Blanco Puro.</p>
                    </div>
                    <div class="result-box hidden" id="bgResult">
                      <div class="bg-demo-canvas" id="canvasBgPreview">
                        <div class="centered-product">
                          <div class="shoe-silhouette">👟 TENIS RUNNING</div>
                        </div>
                      </div>
                      <div class="result-meta">
                        <span class="tag-success">✓ Estándar Falabella #FFFFFF</span>
                        <span class="tag-info">Margen: 8%</span>
                        <button class="app-btn btn-secondary sm" onclick="alert('Descargando ZIP con recortes...')">📦 Descargar ZIP</button>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </article>

            <!-- App 3: Descripción de Producto CatalogAI -->
            <article class="app-card" data-category="catalog" id="card-desc">
              <div class="card-header">
                <div class="app-icon blue-glow">📝</div>
                <div class="card-titles">
                  <span class="app-tag">CATALOG-AI PROTOCOL</span>
                  <h3>Descripción de Producto & Títulos SEO</h3>
                </div>
                <span class="status-pill active">🟢 Servicio Activo</span>
              </div>
              <p class="card-desc">
                Generador masivo de títulos optimizados, viñetas persuasivas de valor y atributos estructurados con algoritmos orientados al SEO de Mercado Libre, Falabella y Amazon.
              </p>

              <div class="workspace-box">
                <div class="ws-header">
                  <h4>Espacio de Trabajo: Optimización CatalogAI</h4>
                  <span class="engine-badge">Protocolo: CatalogAI v4.2</span>
                </div>

                <div class="ws-body">
                  <div class="form-group">
                    <label for="prodTitleInput">Título Actual o Nombre de Producto</label>
                    <input type="text" id="prodTitleInput" value="Tenis deportivos para hombre color negro marca Runflex" class="app-input" />
                  </div>

                  <div class="form-row">
                    <div class="form-group half">
                      <label>Categoría Principal</label>
                      <input type="text" id="prodCategory" value="Deportes y Calzado" class="app-input" />
                    </div>
                    <div class="form-group half">
                      <label>Canal Destino</label>
                      <select id="targetMarketplace" class="app-select">
                        <option value="mercadolibre">Mercado Libre (SEO Max)</option>
                        <option value="falabella">Falabella Seller Center</option>
                        <option value="amazon">Amazon SP-API Listing</option>
                      </select>
                    </div>
                  </div>

                  <div class="form-group">
                    <label>Atributos Clave (Separados por coma)</label>
                    <input type="text" id="prodAttrs" value="Suela antideslizante, malla transpirable, amortiguación EVA, talla 39-43" class="app-input" />
                  </div>

                  <button class="app-btn btn-primary" id="btnOptimizeDesc">
                    <span>🚀 Generar Título & Descripción CatalogAI</span>
                  </button>

                  <div class="preview-stage" id="descStage">
                    <div class="placeholder-content" id="descPlaceholder">
                      <p>Ingresa los datos de tu producto y haz clic para generar el paquete de contenido SEO.</p>
                    </div>
                    <div class="result-box hidden" id="descResult">
                      <div class="catalog-output">
                        <div class="output-item">
                          <span class="out-label">TÍTULO OPTIMIZADO (60/60 caracteres SEO)</span>
                          <div class="out-value highlight" id="outTitle">Tenis Deportivos Hombre Runflex Transpirables Suela Antideslizante</div>
                        </div>
                        <div class="output-item">
                          <span class="out-label">VIÑETAS PERSUASIVAS (BULLET POINTS)</span>
                          <ul class="out-bullets" id="outBullets">
                            <li><strong>MÁXIMA TRANSPIRABILIDAD:</strong> Malla técnica con flujo de aire continuo para entrenamientos de alto rendimiento.</li>
                            <li><strong>AMORTIGUACIÓN EVA:</strong> Absorción de impactos superior que protege articulaciones en carreras y caminatas largas.</li>
                            <li><strong>SUELA TRACCIÓN TOTAL:</strong> Compuesto de goma antideslizante diseñado para agarre seguro en asfalto y gimnasio.</li>
                          </ul>
                        </div>
                        <div class="output-badges">
                          <span class="score-badge">CatalogAI Score: 99/100</span>
                          <span class="keyword-tag">#TenisDeportivos</span>
                          <span class="keyword-tag">#SuelaAntideslizante</span>
                          <span class="keyword-tag">#CalzadoHombre</span>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </article>

            <!-- App 4: Marketplaces Service -->
            <article class="app-card" data-category="marketplaces" id="card-mp">
              <div class="card-header">
                <div class="app-icon purple-glow">🛒</div>
                <div class="card-titles">
                  <span class="app-tag">VITRINA HUB CONNECTOR</span>
                  <h3>Marketplaces Sync & Channel Connector</h3>
                </div>
                <span class="status-pill active">🟢 APIs en Línea</span>
              </div>
              <p class="card-desc">
                Conexión directa con las APIs oficiales de Mercado Libre, Falabella, Amazon SP-API y Homecenter para auditar, sincronizar y publicar atributos masivamente.
              </p>

              <div class="workspace-box">
                <div class="ws-header">
                  <h4>Espacio de Trabajo: Matriz de Canales & Publicaciones</h4>
                  <span class="engine-badge">Port: 3001 (marketplaces-service)</span>
                </div>

                <div class="ws-body">
                  <div class="channels-matrix">
                    <div class="channel-chip connected">
                      <span class="ch-icon">💛</span>
                      <div class="ch-info">
                        <strong>Mercado Libre API</strong>
                        <small>Sincronización activa (24 SKUs)</small>
                      </div>
                      <span class="ch-badge">Conectado</span>
                    </div>

                    <div class="channel-chip connected">
                      <span class="ch-icon">💚</span>
                      <div class="ch-info">
                        <strong>Falabella Seller Center</strong>
                        <small>Atributos validados (18 SKUs)</small>
                      </div>
                      <span class="ch-badge">Conectado</span>
                    </div>

                    <div class="channel-chip syncing">
                      <span class="ch-icon">🧡</span>
                      <div class="ch-info">
                        <strong>Amazon SP-API</strong>
                        <small>Sincronizando feeds...</small>
                      </div>
                      <span class="ch-badge warning">En Cola</span>
                    </div>

                    <div class="channel-chip connected">
                      <span class="ch-icon">💙</span>
                      <div class="ch-info">
                        <strong>Homecenter / Sodimac</strong>
                        <small>Catálogo actualizado</small>
                      </div>
                      <span class="ch-badge">Conectado</span>
                    </div>
                  </div>

                  <div class="form-group margin-top">
                    <label for="skuLookup">Consultar Publicación por SKU o Item ID</label>
                    <div class="input-with-button">
                      <input type="text" id="skuLookup" value="MCO-984210492" class="app-input" />
                      <button class="app-btn btn-secondary" id="btnCheckListing">🔎 Auditar Listing</button>
                    </div>
                  </div>

                  <div class="preview-stage" id="mpStage">
                    <div class="result-box" id="mpResult">
                      <div class="audit-card">
                        <div class="audit-header">
                          <span class="sku-title">SKU: MCO-984210492 · Mercado Libre Colombia</span>
                          <span class="audit-score">Salud SEO: 96%</span>
                        </div>
                        <div class="audit-details">
                          <div class="detail-row">
                            <span>Título Publicado:</span>
                            <strong>Tenis Deportivos Hombre Runflex Transpirables</strong>
                          </div>
                          <div class="detail-row">
                            <span>Calidad de Atributos:</span>
                            <span class="tag-success">✓ 14/14 Atributos Requeridos Llenos</span>
                          </div>
                          <div class="detail-row">
                            <span>Imágenes Principales:</span>
                            <span class="tag-success">✓ Fondo Blanco #FFFFFF Cumplido</span>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </article>

            <!-- App 5: Estudios de Mercado & Inteligencia SEO -->
            <article class="app-card" data-category="market-research" id="card-market-research">
              <div class="card-header">
                <div class="app-icon amber-glow">📊</div>
                <div class="card-titles">
                  <span class="app-tag">CATALOG-AI MARKET INTELLIGENCE</span>
                  <h3>Estudios de Mercado & Búsquedas por Categoría</h3>
                </div>
                <span class="status-pill active">🟢 Dataset 2026 Actualizado</span>
              </div>
              <p class="card-desc">
                Explora y desagrega el comportamiento real de búsqueda de los compradores en Colombia (Google Keyword Planner & Marketplace Search Volume). Filtra por categorías, sub-clusters, intención de búsqueda y detecta Quick Wins para alimentar el protocolo CatalogAI.
              </p>

              <div class="workspace-box">
                <div class="ws-header">
                  <h4>Espacio de Trabajo: Explorador de Demanda & Palabras Clave</h4>
                  <span class="engine-badge">Base de Datos: Keyword Planner 2026</span>
                </div>

                <div class="ws-body">
                  <!-- Category & Cluster Filters -->
                  <div class="form-row">
                    <div class="form-group half">
                      <label for="mrCategorySelect">Categoría Principal de Mercado</label>
                      <select id="mrCategorySelect" class="app-select">
                        <option value="ollas" selected>🍲 Ollas, Sartenes & Baterías de Cocina (+250k búsquedas/mes)</option>
                        <option value="deportes">👟 Calzado Deportivo & Snickers (+180k búsquedas/mes)</option>
                        <option value="hogar">🏠 Electrodomésticos de Hogar (+140k búsquedas/mes)</option>
                        <option value="tecnologia">📱 Gadgets & Tecnología (+210k búsquedas/mes)</option>
                      </select>
                    </div>

                    <div class="form-group half">
                      <label for="mrClusterSelect">Sub-Cluster Semántico</label>
                      <select id="mrClusterSelect" class="app-select">
                        <option value="all" selected>Todos los Sub-Clusters</option>
                        <option value="presion">🔥 Ollas a Presión / Express & Pitadoras</option>
                        <option value="arroceras">🍚 Ollas Arroceras & Vaporeras</option>
                        <option value="multifuncional">⚡ Multifuncionales / Air Fryer</option>
                        <option value="baterias">🍳 Baterías de Cocina & Juegos</option>
                        <option value="sartenes">🍳 Sartenes & Antiadherentes</option>
                        <option value="hierro">🧱 Hierro Fundido, Barro & Vidrio</option>
                        <option value="salud">🩺 Consultas de Salud / PFOA / Toxicidad</option>
                        <option value="quickwins">🚀 Quick Wins (Alto Crecimiento YoY)</option>
                      </select>
                    </div>
                  </div>

                  <!-- Real-time search filter -->
                  <div class="form-group">
                    <label for="mrSearchInput">Filtrar Término o Palabra Clave en Tiempo Real</label>
                    <div class="input-with-button">
                      <input type="text" id="mrSearchInput" placeholder="Ejemplo: imusa, acero inoxidable, teflon, 6 litros, oster..." class="app-input" />
                      <button class="app-btn btn-secondary" id="btnResetMR">🔄 Limpiar Filtros</button>
                    </div>
                  </div>

                  <!-- KPIs summary bar -->
                  <div class="mr-kpis-bar">
                    <div class="kpi-card">
                      <span class="kpi-label">Volumen Total Filtrado</span>
                      <strong class="kpi-val" id="mrKpiVolume">254.800/mes</strong>
                    </div>
                    <div class="kpi-card">
                      <span class="kpi-label">Palabras Clave Visibles</span>
                      <strong class="kpi-val" id="mrKpiCount">0 Términos</strong>
                    </div>
                    <div class="kpi-card">
                      <span class="kpi-label">Top Crecimiento YoY</span>
                      <strong class="kpi-val highlight" id="mrKpiGrowth">Titanio (+555%)</strong>
                    </div>
                    <div class="kpi-card">
                      <span class="kpi-label">Intención Comercial</span>
                      <strong class="kpi-val success">86% Transaccional</strong>
                    </div>
                  </div>

                  <!-- Keyword Table Container -->
                  <div class="table-responsive-wrapper margin-top">
                    <table class="mr-table" id="mrTable">
                      <thead>
                        <tr>
                          <th>Palabra Clave</th>
                          <th>Búsquedas/Mes</th>
                          <th>YoY Change</th>
                          <th>Competencia</th>
                          <th>Intención</th>
                          <th>Mapeo CatalogAI (Módulo 7 / Section)</th>
                        </tr>
                      </thead>
                      <tbody id="mrTableBody">
                        <!-- Populated by JS -->
                      </tbody>
                    </table>
                  </div>

                  <!-- Action Bar -->
                  <div class="mr-actions margin-top">
                    <a href="/estudios-de-mercado" class="app-btn btn-primary sm" style="text-decoration: none;">
                      <span>🚀 Abrir Módulo Completo en URL Dedicada (/estudios-de-mercado)</span>
                    </a>
                    <button class="app-btn btn-secondary sm" id="btnExportCSV">
                      <span>📊 Exportar Dataset (CSV)</span>
                    </button>
                    <button class="app-btn btn-secondary sm" id="btnCopyCatalogFormat">
                      <span>📋 Copiar para CatalogAI</span>
                    </button>
                  </div>
                </div>
              </div>
            </article>


          </div>
        </div>
      </section>

    </div>

  </main>
</Base>

<style>
  /* Base Portal Styles */
  .portal-main {
    background: #0B1F3A;
    color: #ffffff;
    min-height: 100vh;
    padding-bottom: 80px;
    font-family: var(--font-body);
  }

  .hidden {
    display: none !important;
  }

  /* LOGIN GATE STYLES */
  .login-container {
    padding: 80px 0;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .login-card {
    background: rgba(30, 39, 97, 0.5);
    border: 1px solid rgba(176, 141, 87, 0.3);
    border-radius: 20px;
    padding: 40px;
    max-width: 520px;
    margin: 0 auto;
    backdrop-filter: blur(12px);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4);
    text-align: center;
  }

  .lock-badge {
    display: inline-block;
    background: rgba(176, 141, 87, 0.15);
    color: #B08D57;
    border: 1px solid rgba(176, 141, 87, 0.3);
    padding: 4px 12px;
    border-radius: 9999px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.5px;
    margin-bottom: 16px;
  }

  .login-logo {
    display: block;
    margin: 0 auto 16px auto;
  }

  .login-title {
    font-family: var(--font-display);
    font-size: 26px;
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 10px;
  }

  .login-subtitle {
    font-size: 14px;
    color: #b3b3b3;
    line-height: 1.5;
    margin-bottom: 28px;
  }

  .login-form {
    text-align: left;
  }

  .alert-box {
    padding: 12px 16px;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 600;
    margin-bottom: 16px;
  }

  .alert-box.error {
    background: rgba(220, 38, 38, 0.15);
    border: 1px solid rgba(220, 38, 38, 0.4);
    color: #fca5a5;
  }

  .alert-box.success {
    background: rgba(27, 175, 122, 0.15);
    border: 1px solid rgba(27, 175, 122, 0.4);
    color: #6ee7b7;
  }

  .login-footer {
    margin-top: 24px;
    padding-top: 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 12px;
    color: #838383;
  }

  .login-footer code {
    color: #B08D57;
  }

  /* SESSION BAR */
  .session-bar {
    background: rgba(0, 0, 0, 0.4);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding: 12px 0;
  }

  .session-in {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .session-info {
    display: flex;
    align-items: center;
