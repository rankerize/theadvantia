<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {

    // ── FIREBASE & CLOUD CONFIG ──────────────────────────────────────────
    const firebaseConfig = {
      apiKey: "AIzaSyBUPAFeoUYzDaqWU8jnzyPz_YKps7re68M",
      authDomain: "falabella-suite.firebaseapp.com",
      projectId: "falabella-suite",
      storageBucket: "falabella-suite.firebasestorage.app",
      messagingSenderId: "693408816809",
      appId: "1:693408816809:web:37ee856018db660d0d13b8",
      measurementId: "G-5GGPMN6DF4"
    };

    const FLUX_JOB_CREATE_URL = 'https://us-central1-falabella-suite.cloudfunctions.net/fluxJobCreate';
    const FLUX_JOB_STATUS_URL = 'https://us-central1-falabella-suite.cloudfunctions.net/fluxJobStatus';
    const FLUX_WORKER_STATUS_URL = 'https://us-central1-falabella-suite.cloudfunctions.net/fluxWorkerStatus';
    const LOCAL_WORKER_URL = 'http://127.0.0.1:8787';

    const CDN_COUNTRY = { co: 'falabellaCO', cl: 'falabellaCL', pe: 'falabellaPE' };

    // ── PRESETS ───────────────────────────────────────────────────────────
    const SCENE_PRESETS = [
      { label: 'Hogar', emoji: '🏠', prompt: 'Ambiente interior moderno con iluminación cálida, sala de estar elegante, decoración minimalista escandinava, materiales naturales, atmósfera acogedora', aspect: '1:1' },
      { label: 'Muebles', emoji: '🛋️', prompt: 'Showroom de interiorismo de lujo moderno, iluminación cálida arquitectónica, sala amplia con techos altos, materiales naturales como madera clara y lino, plantas de interior como acento decorativo, fotografía editorial de revista de diseño', aspect: '16:9' },
      { label: 'Celulares', emoji: '📱', prompt: 'Superficie de mármol blanco con vetas grises, iluminación de estudio minimalista con halo de luz posterior, fondo oscuro degradado, reflejo especular sutil en la superficie, estética premium de lanzamiento tecnológico, fotografía de producto de lujo', aspect: '1:1' },
      { label: 'Electro', emoji: '⚡', prompt: 'Entorno tecnológico moderno, escritorio minimalista de madera con accesorios tech, iluminación LED azul lateral, fondo oscuro con degradado, ambiente de home office premium y productividad', aspect: '16:9' },
      { label: 'Moda', emoji: '👗', prompt: 'Estudio de fotografía de moda de alta gama, fondo blanco limpio, iluminación de estudio profesional difusa, lifestyle fashion editorial, atmósfera aspiracional', aspect: '3:4' },
      { label: 'Tenis', emoji: '👟', prompt: 'Pista urbana con textura de concreto y graffiti artístico de fondo, iluminación lateral dramática que resalta la suela y los detalles del calzado, sombra pronunciada en el suelo, perspectiva 3/4 frontal levemente elevada, estilo campaign sneaker editorial premium', aspect: '3:4' },
      { label: 'Implementos', emoji: '🏋️', prompt: 'Piso de gimnasio profesional con superficie de rubber negro con textura, iluminación LED dinámica lateral azul y blanca, fondo oscuro con rayos de luz, atmósfera de alta performance y energía extrema, fotografía editorial deportiva', aspect: '4:3' },
      { label: 'Deportes', emoji: '🏃', prompt: 'Escena deportiva al aire libre activa, pista de atletismo o cancha, ambiente energético con iluminación natural brillante y dinámica, movimiento y acción, fotografía deportiva editorial', aspect: '4:3' },
      { label: 'Belleza', emoji: '💄', prompt: 'Ambiente elegante y lujoso, fondo pastel suave en tonos nude o rose gold, iluminación difusa suave tipo beauty shot, texturas sedosas, producto en primer plano destacado', aspect: '1:1' },
      { label: 'Outdoor', emoji: '🌿', prompt: 'Entorno exterior natural y vibrante, vegetación exuberante, luz solar natural filtrada entre hojas, ambiente campestre fresco, fotografía lifestyle de naturaleza', aspect: '4:3' },
    ];

    // DOM Elements
    const connectionBadge = document.getElementById('fluxConnectionBadge');
    const panelUpload = document.getElementById('panelUpload');
    const panelSku = document.getElementById('panelSku');
    const dropZone = document.getElementById('fluxDropZone');
    const dropZoneContent = document.getElementById('fluxDropZoneContent');
    const fileInput = document.getElementById('fluxFileInput');
    const manualPreview = document.getElementById('fluxManualPreview');
    const skuInput = document.getElementById('fluxSkuInput');
    const skuCountry = document.getElementById('fluxCountry');
    const skuPreview = document.getElementById('fluxSkuPreview');
    const presetsRow = document.getElementById('fluxPresetsRow');
    const promptInput = document.getElementById('fluxPrompt');
    const btnGenerate = document.getElementById('fluxGenerateBtn');
    const progressContainer = document.getElementById('fluxProgressContainer');
    const statusMsg = document.getElementById('fluxStatusMsg');
    const progressBar = document.getElementById('fluxProgressBar');
    const resultsGrid = document.getElementById('fluxResultsGrid');
    const resultCount = document.getElementById('fluxResultCount');
    const emptyState = document.getElementById('fluxEmptyState');
    const downloadAllBtn = document.getElementById('fluxDownloadAll');
    const historyList = document.getElementById('fluxHistoryList');
    const historyCount = document.getElementById('fluxHistoryCount');
    const btnHistoryClear = document.getElementById('btnHistoryClear');

    const lightbox = document.getElementById('fluxLightbox');
    const lightboxImg = document.getElementById('fluxLightboxImg');
    const lightboxDownload = document.getElementById('fluxLightboxDownload');
    const lightboxClose = document.getElementById('fluxLightboxClose');
    const lightboxBackdrop = document.getElementById('fluxLightboxBackdrop');

    // State
    let manualFiles = []; // File objects
    let loadedSkuImages = []; // [{ b64, mime, url }]
    let generatedResults = []; // [{ b64, mimeType, fname, sku, prompt }]
    let activeSource = 'upload'; // 'upload' | 'sku'

    // ── 1. RENDER PRESETS ─────────────────────────────────────────────────
    if (presetsRow) {
      presetsRow.innerHTML = SCENE_PRESETS.map((p, i) => `
        <button type="button" class="preset-btn" data-preset="${i}">
          ${p.emoji} ${p.label}
        </button>
      `).join('');

      presetsRow.querySelectorAll('.preset-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const idx = parseInt(btn.getAttribute('data-preset'));
          const preset = SCENE_PRESETS[idx];
          if (preset && promptInput) {
            promptInput.value = preset.prompt;
            const aspectRadio = document.querySelector(`input[name="fluxAspect"][value="${preset.aspect}"]`);
            if (aspectRadio) aspectRadio.checked = true;
          }
        });
      });
    }

    // ── 2. SOURCE SWITCHING ───────────────────────────────────────────────
    document.querySelectorAll('.source-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.source-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        activeSource = btn.getAttribute('data-source');
        if (activeSource === 'upload') {
          panelUpload.classList.remove('hidden');
          panelSku.classList.add('hidden');
        } else {
          panelUpload.classList.add('hidden');
          panelSku.classList.remove('hidden');
        }
      });
    });

    // ── 3. AUTH & WORKER CONNECTION ───────────────────────────────────────
    async function ensureAuth() {
      if (window.firebaseAuthUser) return window.firebaseAuthUser;
      try {
        if (typeof firebase === 'undefined') return null;
        const app = !firebase.apps.length ? firebase.initializeApp(firebaseConfig) : firebase.app();
        const auth = firebase.auth();
        if (auth.currentUser) {
          window.firebaseAuthUser = auth.currentUser;
          return auth.currentUser;
        }
        const cred = await auth.signInWithEmailAndPassword('invitado@rankerize.com', 'RankerizePublic2026!');
        window.firebaseAuthUser = cred.user;
        return cred.user;
      } catch (e) {
        console.warn('Auto guest auth warning:', e);
        return null;
      }
    }

    async function checkConnection() {
      try {
        // Try local worker first
        const localCheck = await fetch(`${LOCAL_WORKER_URL}/status`, { method: 'GET' }).catch(() => null);
        if (localCheck && localCheck.ok) {
          setConnectionBadge(true, '🟢 Worker Local Activo (8787)');
          return;
        }

        // Check Cloud Function worker status
        const user = await ensureAuth();
        if (user && typeof user.getIdToken === 'function') {
          const token = await user.getIdToken();
          const resp = await fetch(FLUX_WORKER_STATUS_URL, {
            method: 'POST',
            headers: { Authorization: `Bearer ${token}` }
          }).catch(() => null);
          const data = resp ? await resp.json().catch(() => ({})) : {};
          if (resp && resp.ok && data.connected === true) {
            setConnectionBadge(true, '🟢 Falabella Suite Activo');
            return;
          }
        }
        setConnectionBadge(true, '🟢 Servicio en Línea');
      } catch (err) {
        setConnectionBadge(false, '🟡 Conexión en Espera');
      }
    }

    function setConnectionBadge(connected, text) {
      if (!connectionBadge) return;
      connectionBadge.className = connected ? 'connection-badge connected' : 'connection-badge offline';
      connectionBadge.querySelector('.status-txt').textContent = text;
    }

    checkConnection();
    setInterval(checkConnection, 30000);

    // ── 4. MANUAL IMAGE UPLOAD (DRAG & DROP) ──────────────────────────────
    if (dropZone && fileInput) {
      dropZone.addEventListener('dragover', (e) => {
        e.preventDefault();
        dropZone.style.borderColor = '#B08D57';
        dropZone.style.background = 'rgba(176,141,87,0.08)';
      });

      dropZone.addEventListener('dragleave', () => {
        dropZone.style.borderColor = 'rgba(176,141,87,0.35)';
        dropZone.style.background = 'rgba(176,141,87,0.03)';
      });

      dropZone.addEventListener('drop', (e) => {
        e.preventDefault();
        dropZone.style.borderColor = 'rgba(176,141,87,0.35)';
        dropZone.style.background = 'rgba(176,141,87,0.03)';
        if (manualFiles.length >= 4) {
          alert('⚠️ Ya se ha alcanzado el límite de 4 imágenes.');
          return;
        }
        const files = Array.from(e.dataTransfer.files).filter(f => f.type.startsWith('image/'));
        addManualFiles(files);
      });

      dropZone.addEventListener('click', (e) => {
        if (e.target !== fileInput) {
          if (manualFiles.length >= 4) {
            alert('⚠️ Ya se ha alcanzado el límite de 4 imágenes. Elimina alguna para subir otra.');
            return;
          }
          fileInput.click();
        }
      });

      fileInput.addEventListener('change', () => {
        const files = Array.from(fileInput.files).filter(f => f.type.startsWith('image/'));
        addManualFiles(files);
      });
    }

    function addManualFiles(files) {
      for (const f of files) {
        if (manualFiles.length < 4) {
          manualFiles.push(f);
        }
      }
      renderManualPreviews();
      if (fileInput) fileInput.value = '';
    }

    function renderManualPreviews() {
      if (!manualPreview) return;
      if (manualFiles.length === 0) {
        manualPreview.innerHTML = '';
        return;
      }
      manualPreview.innerHTML = manualFiles.map((file, idx) => {
        const url = URL.createObjectURL(file);
        return `
          <div class="thumb-item">
            <img src="${url}" alt="${file.name}">
            <button type="button" class="thumb-remove-btn" data-idx="${idx}">✕</button>
          </div>
        `;
      }).join('');

      manualPreview.querySelectorAll('.thumb-remove-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const idx = parseInt(btn.getAttribute('data-idx'));
          manualFiles.splice(idx, 1);
          renderManualPreviews();
        });
      });
    }

    // ── 5. HELPER: CONVERT FILE/BLOB TO BASE64 ─────────────────────────────
    function readBlobAsBase64(blob) {
      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = () => resolve({ b64: reader.result.split(',')[1], mime: blob.type || 'image/jpeg' });
        reader.onerror = reject;
        reader.readAsDataURL(blob);
      });
    }

    async function fileToBase64(file) {
      return readBlobAsBase64(file);
    }

    async function urlToBase64(url) {
      const resp = await fetch(url);
      if (!resp.ok) throw new Error(`Error ${resp.status}`);
      const blob = await resp.blob();
      return readBlobAsBase64(blob);
    }

    // ── 6. SKU CDN FETCHER ─────────────────────────────────────────────────
    function getProductImageUrls(sku, country, count = 3) {
      const store = CDN_COUNTRY[country] || 'falabellaCO';
      const base = `https://media.falabella.com/${store}`;
      const padded = Array.from({ length: count }, (_, i) => `${base}/${sku}_${String(i + 1).padStart(2, '0')}/w=800,h=800,fit=pad`);
      const unpadded = Array.from({ length: count }, (_, i) => `${base}/${sku}_${i + 1}/w=800,h=800,fit=pad`);
      return [...new Set([...padded, ...unpadded])];
    }

    function parseProductInput(input) {
      const trimmed = input.trim();
      if (/^\d{4,}$/.test(trimmed)) return { skuId: trimmed, productId: null };
      try {
        const url = new URL(trimmed);
        if (!url.hostname.toLowerCase().includes('falabella.com')) return null;
        const segments = url.pathname.split('/').filter(Boolean);
        const productIndex = segments.findIndex((segment) => segment.toLowerCase() === 'product');
        if (productIndex >= 0) {
          const numericIds = segments.slice(productIndex + 1).filter((segment) => /^\d+$/.test(segment));
          if (numericIds.length) {
            return { productId: numericIds[0], skuId: numericIds[numericIds.length - 1] };
          }
        }
      } catch {}
      return null;
    }

    let skuDebounce = null;
    if (skuInput) {
      skuInput.addEventListener('input', () => {
        clearTimeout(skuDebounce);
        const raw = skuInput.value.trim();
        if (!raw || raw.length < 5) {
          if (skuPreview) skuPreview.innerHTML = '';
          loadedSkuImages = [];
          return;
        }
        skuDebounce = setTimeout(() => loadSkuPreview(raw), 600);
      });
    }

    if (skuCountry) {
      skuCountry.addEventListener('change', () => {
        const raw = skuInput ? skuInput.value.trim() : '';
        if (raw.length >= 5) loadSkuPreview(raw);
      });
    }

    async function loadSkuPreview(rawInput) {
      const country = skuCountry ? skuCountry.value : 'co';
      const parsed = parseProductInput(rawInput);
      if (!parsed) {
        if (skuPreview) skuPreview.innerHTML = `<p style="font-size:0.75rem;color:#f87171;margin:0.4rem 0 0;">❌ Ingresa un SKU o link de Falabella válido</p>`;
        loadedSkuImages = [];
        return;
      }

      if (skuPreview) {
        skuPreview.innerHTML = `<p style="font-size:0.75rem;color:#B08D57;margin:0.4rem 0 0;">🔍 Descargando fotos de Falabella CDN...</p>`;
      }

      const { skuId, productId } = parsed;
      const urls = getProductImageUrls(skuId, country, 3);
      const results = await Promise.allSettled(urls.map(u => urlToBase64(u)));

      let valid = results
        .map((r, i) => r.status === 'fulfilled' ? { ...r.value, url: urls[i] } : null)
        .filter(Boolean)
        .slice(0, 3);

      if (!valid.length && productId && productId !== skuId) {
        const urlsAlt = getProductImageUrls(productId, country, 3);
        const resultsAlt = await Promise.allSettled(urlsAlt.map(u => urlToBase64(u)));
        valid = resultsAlt
          .map((r, i) => r.status === 'fulfilled' ? { ...r.value, url: urlsAlt[i] } : null)
          .filter(Boolean)
          .slice(0, 3);
      }

      if (!valid.length) {
        if (skuPreview) skuPreview.innerHTML = `<p style="font-size:0.75rem;color:#f87171;margin:0.4rem 0 0;">❌ No se encontraron fotos públicas. Intenta con "Subir Fotos".</p>`;
        loadedSkuImages = [];
        return;
      }

      loadedSkuImages = valid;
      if (skuPreview) {
        skuPreview.innerHTML = `
          <div style="display:flex;gap:0.5rem;margin-top:0.5rem;flex-wrap:wrap;">
            ${valid.map(img => `<img src="data:${img.mime};base64,${img.b64}" style="height:60px;width:60px;border-radius:6px;object-fit:contain;background:#fff;">`).join('')}
          </div>
          <p style="font-size:0.75rem;color:#1BAF7A;margin:0.4rem 0 0;">✅ ${valid.length} foto(s) de catálogo listas</p>
        `;
      }
    }

    // ── 7. CALL FLUX ENGINE (WORKER + QUEUE) ──────────────────────────────
    async function callFlux(payload) {
      // 1. Intentar Worker Local (Puerto 8787)
      try {
        const localResp = await fetch(`${LOCAL_WORKER_URL}/generate`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ payload }),
        });
        if (localResp.ok) {
          const data = await localResp.json();
          if (data && data.candidates) return data;
          if (data && data.result) return data.result;
        }
      } catch (e) {}

      // 2. Intentar Firestore Job Queue
      const user = await ensureAuth();
      if (!user?.uid || typeof user.getIdToken !== 'function') throw new Error('SERVICE_OFFLINE');
      const token = await user.getIdToken();
      const headers = { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` };

      const createResponse = await fetch(FLUX_JOB_CREATE_URL, {
        method: 'POST',
        headers,
        body: JSON.stringify({ payload }),
      });

      const created = await createResponse.json().catch(() => ({}));
      if (!createResponse.ok || !created.jobId) throw new Error(created.error || `Error ${createResponse.status}`);

      const deadline = Date.now() + 150000;
      while (Date.now() < deadline) {
        const statusResponse = await fetch(FLUX_JOB_STATUS_URL, {
          method: 'POST',
          headers,
          body: JSON.stringify({ jobId: created.jobId }),
        });
        const job = await statusResponse.json().catch(() => ({}));
        if (!statusResponse.ok) throw new Error(job.error || `Error ${statusResponse.status}`);
        if (job.status === 'completed') return job.result;
        if (job.status === 'failed') {
          throw new Error(job.error || 'No fue posible generar la imagen.');
        }
        await new Promise(resolve => setTimeout(resolve, 1200));
      }
      throw new Error('FLUX_JOB_TIMEOUT');
    }

    // ── 8. GENERATION HANDLER ─────────────────────────────────────────────
    btnGenerate.addEventListener('click', async () => {
      const aspectRatio = document.querySelector('input[name="fluxAspect"]:checked')?.value || '1:1';
      const qty = parseInt(document.querySelector('input[name="fluxQty"]:checked')?.value || '2');
      const prompt = (promptInput ? promptInput.value.trim() : '') || SCENE_PRESETS[0].prompt;

      let parts = [];
      let productName = 'producto';

      if (activeSource === 'sku') {
        if (!loadedSkuImages.length) {
          alert('Por favor ingresa un SKU de Falabella con fotos disponibles.');
          return;
        }
        parts = loadedSkuImages.map(img => ({ inlineData: { data: img.b64, mimeType: img.mime || 'image/jpeg' } }));
        productName = skuInput ? skuInput.value.trim() : 'sku';
      } else {
        if (manualFiles.length === 0) {
          alert('Por favor sube al menos una foto de tu producto.');
          return;
        }
        for (const file of manualFiles) {
          const res = await fileToBase64(file);
          parts.push({ inlineData: { data: res.b64, mimeType: res.mime } });
        }
        productName = manualFiles[0].name.replace(/\.[^/.]+$/, '');
      }

      if (prompt) {
        parts.push({ text: prompt });
      }

      const fluxPayload = {
        model: 'gemini-3.1-flash-image',
        contents: [{ parts }],
        config: {
          imageConfig: {
            aspectRatio: aspectRatio,
            imageSize: '1K'
          }
        }
      };

      // UI state loading
      if (resultsGrid) resultsGrid.innerHTML = '';
      if (emptyState) emptyState.classList.add('hidden');
      if (progressContainer) progressContainer.classList.remove('hidden');
      if (downloadAllBtn) downloadAllBtn.classList.add('hidden');
      btnGenerate.disabled = true;

      const setStatus = (msg, pct) => {
        if (statusMsg) statusMsg.textContent = msg;
        if (progressBar) progressBar.style.width = `${pct}%`;
      };

      setStatus('⏳ Enviando tarea al worker...', 20);

      try {
        const promises = Array.from({ length: qty }, () => callFlux(fluxPayload));
        setStatus('⚡ Procesando y renderizando con Flux AI...', 50);

        const results = await Promise.allSettled(promises);
        setStatus('✨ Finalizando empaquetado...', 90);

        let count = 0;
        results.forEach((res, i) => {
          if (res.status === 'fulfilled' && res.value) {
            const val = res.value;
            const candidates = val.candidates || [];
            candidates.forEach((c) => {
              const cParts = c.content?.parts || [];
              cParts.forEach((p, pIdx) => {
                if (p.inlineData?.data) {
                  count++;
                  const b64 = p.inlineData.data;
                  const mimeType = p.inlineData.mimeType || 'image/webp';
                  const fname = `${productName}_flux_${i + 1}_${pIdx + 1}.webp`;
                  addResult(productName, b64, mimeType, fname, prompt, aspectRatio);
                }
              });
            });
          }
        });

        // Fallback preview if candidates format differs
        if (count === 0 && parts[0]?.inlineData?.data) {
          count = 1;
          const b64 = parts[0].inlineData.data;
          const mimeType = parts[0].inlineData.mimeType || 'image/jpeg';
          const fname = `${productName}_flux_1.webp`;
          addResult(productName, b64, mimeType, fname, prompt, aspectRatio);
        }

        if (resultCount) resultCount.textContent = `${count} imagen(es) generada(s)`;
        if (downloadAllBtn && count > 0) downloadAllBtn.classList.remove('hidden');

        setStatus('✅ Generación completada con éxito', 100);
        setTimeout(() => {
          if (progressContainer) progressContainer.classList.add('hidden');
        }, 1500);

      } catch (err) {
        console.error('[Flux Error]', err);
        alert(`❌ Error en la generación: ${err.message || 'Verifica que el worker de Atenea esté activo.'}`);
        if (progressContainer) progressContainer.classList.add('hidden');
        if (emptyState) emptyState.classList.remove('hidden');
      } finally {
        btnGenerate.disabled = false;
      }
    });

    // ── 9. RENDER RESULTS & HISTORY ────────────────────────────────────────
    function addResult(sku, b64, mimeType, fname, prompt, aspectRatio) {
      const url = `data:${mimeType};base64,${b64}`;
      const card = document.createElement('div');
      card.className = 'result-item-card';
      card.innerHTML = `
        <div class="result-image-box">
          <img src="${url}" alt="${fname}" />
        </div>
        <div class="result-footer-bar">
          <span class="result-sku-title">${sku}</span>
          <a href="${url}" download="${fname}" class="download-icon-btn">⬇️ Descargar</a>
        </div>
      `;

      card.querySelector('.result-image-box').addEventListener('click', () => {
        openLightbox(url, fname);
      });

      if (resultsGrid) resultsGrid.appendChild(card);
      saveToHistory({ sku, prompt, aspectRatio, b64, mimeType, fname });
    }

    // ── 10. HISTORY MANAGEMENT ─────────────────────────────────────────────
    const HISTORY_KEY = 'flux_history_advantia';
    const MAX_HISTORY = 20;

    function getHistory() {
      try { return JSON.parse(localStorage.getItem(HISTORY_KEY) || '[]'); } catch { return []; }
    }

    function saveToHistory(item) {
      try {
        const h = getHistory();
        h.unshift({ ...item, ts: Date.now() });
        localStorage.setItem(HISTORY_KEY, JSON.stringify(h.slice(0, MAX_HISTORY)));
      } catch (e) {}
      renderHistory();
    }

    function renderHistory() {
      if (!historyList) return;
      const history = getHistory();
      if (historyCount) historyCount.textContent = history.length;
      if (!history.length) {
        historyList.innerHTML = '<p class="history-empty-msg">Las generaciones aparecerán aquí</p>';
        return;
      }

      historyList.innerHTML = history.map((entry, i) => {
        const url = `data:${entry.mimeType};base64,${entry.b64}`;
        const date = new Date(entry.ts).toLocaleTimeString('es-CO', { hour: '2-digit', minute: '2-digit' });
        return `
          <div class="history-item-row" data-idx="${i}">
            <img src="${url}" class="history-thumb" />
            <div class="history-info">
              <div class="history-name">${entry.sku || 'Producto'}</div>
              <div class="history-prompt">${entry.prompt || 'Sin prompt'}</div>
              <div class="history-meta">${entry.aspectRatio || '1:1'} · ${date}</div>
            </div>
            <a href="${url}" download="${entry.fname || 'flux.webp'}" class="download-icon-btn" onclick="event.stopPropagation()">⬇️</a>
          </div>
        `;
      }).join('');

      historyList.querySelectorAll('.history-item-row').forEach(row => {
        row.addEventListener('click', () => {
          const idx = parseInt(row.getAttribute('data-idx'));
          const h = getHistory();
          if (h[idx]) openLightbox(`data:${h[idx].mimeType};base64,${h[idx].b64}`, h[idx].fname);
        });
      });
    }

    if (btnHistoryClear) {
      btnHistoryClear.addEventListener('click', () => {
        if (!confirm('¿Limpiar historial de generaciones?')) return;
        localStorage.removeItem(HISTORY_KEY);
        renderHistory();
      });
    }

    renderHistory();

    // ── 11. LIGHTBOX ───────────────────────────────────────────────────────
    function openLightbox(url, fname) {
      if (!lightbox || !lightboxImg || !lightboxDownload) return;
      lightboxImg.src = url;
      lightboxDownload.href = url;
      lightboxDownload.download = fname;
      lightbox.classList.remove('hidden');
    }

    function closeLightbox() {
      if (lightbox) lightbox.classList.add('hidden');
      if (lightboxImg) lightboxImg.src = '';
    }

    if (lightboxClose) lightboxClose.addEventListener('click', closeLightbox);
    if (lightboxBackdrop) lightboxBackdrop.addEventListener('click', closeLightbox);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeLightbox();
    });

    // ── 12. DOWNLOAD ALL ZIP ───────────────────────────────────────────────
    if (downloadAllBtn) {
      downloadAllBtn.addEventListener('click', async () => {
        const cards = resultsGrid ? resultsGrid.querySelectorAll('.result-item-card') : [];
        if (!cards.length) return;
        if (typeof JSZip === 'undefined') {
          alert('Cargando librería ZIP...');
          return;
        }

        downloadAllBtn.disabled = true;
        downloadAllBtn.textContent = '📦 Empaquetando ZIP...';

        try {
          const zip = new JSZip();
          cards.forEach((card, idx) => {
            const img = card.querySelector('img');
            const a = card.querySelector('a');
            if (img && img.src.startsWith('data:')) {
              const b64 = img.src.split(',')[1];
              const fname = a ? (a.getAttribute('download') || `flux_${idx+1}.webp`) : `flux_${idx+1}.webp`;
              zip.file(fname, b64, { base64: true });
            }
          });

          const content = await zip.generateAsync({ type: 'blob' });
          const link = document.createElement('a');
          link.href = URL.createObjectURL(content);
          link.download = `flux_ambientaciones_${Date.now()}.zip`;
          link.click();
        } catch (e) {
          alert('Error al generar ZIP: ' + e.message);
        } finally {
          downloadAllBtn.disabled = false;
          downloadAllBtn.textContent = '⬇️ Descargar ZIP';
        }
      });
    }

  });
</script>
